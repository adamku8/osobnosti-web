---
const email = 'kontakt@osobnostiprotrinec.cz';
const fb = 'https://www.facebook.com/osobnostiprotrinec';
---
<footer class="site-footer" id="kontakt">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="footer-logo">Osobnosti <span>pro Třinec</span></div>
        <p>Lokální hnutí. Lidé, kteří berou odpovědnost.<br>Politické hnutí NOVÁ GENERACE</p>
      </div>
      <div>
        <h4>Kontakt</h4>
        <ul>
          <li><a href={`mailto:${email}`}>{email}</a></li>
          <li><a href={fb}>Facebook</a></li>
        </ul>
      </div>
      <div>
        <h4>Web</h4>
        <ul>
          <li><a href="/program.html">Program</a></li>
          <li><a href="/kandidati.html">Kandidáti</a></li>
          <li><a href="/podporte-nas.html">Podpořte nás</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-legal">
      <span>© 2026 Politické hnutí NOVÁ GENERACE</span>
      <span>Zadavatel i zpracovatel: politické hnutí NOVÁ GENERACE</span>
      <span>#SPOJUJEMEGENERACE · #PROTRINEC</span>
    </div>
  </div>
</footer>
