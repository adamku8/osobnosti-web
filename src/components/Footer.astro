---
const fb = 'https://www.facebook.com/osobnostiprotrinec';
const ig = 'https://www.instagram.com/osobnosti_pro_trinec/';
import { u } from '../lib/url.js';
---
<footer class="site-footer" id="kontakt">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="footer-logo">Osobnosti <span>pro Třinec</span></div>
        <p>Stejné hodnoty. Nové vize.</p>
        <p class="footer-social-label">Sledujte nás</p>
        <div class="footer-social">
          <a class="social-btn" href={fb} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
              <path d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.5V4.4c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.4H8.1v3h2.5V21h2.9z"/>
            </svg>
            Facebook
          </a>
          <a class="social-btn" href={ig} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
            </svg>
            Instagram
          </a>
        </div>
      </div>
      <div>
        <h4>Web</h4>
        <ul>
          <li><a href={u('program.html')}>Program</a></li>
          <li><a href={u('casti.html')}>Příměstské části</a></li>
          <li><a href={u('kandidati.html')}>Kandidáti</a></li>
          <li><a href={u('podporte-nas.html')}>Podpořte nás</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-legal">
      <span>© 2026 Politické hnutí NOVÁ GENERACE — zadavatel i zpracovatel</span>
      <span>#SPOJUJEMEGENERACE · #PROTRINEC</span>
    </div>
  </div>
</footer>
