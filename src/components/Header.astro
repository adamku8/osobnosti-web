---
const { active = '' } = Astro.props;

import { u } from '../lib/url.js';
import { PO_VOLBACH } from '../lib/verejne.js';

// Před volbami ploché menu; po volbách (PO_VOLBACH) jsou program a kandidátka schované
// pod skupinou „Volby 2026" (tamtéž hned pod programem i Javorový), přibyla položka
// „Zastupitelstvo" (zápisy ze zasedání)
// a z menu vypadlo kampaňové „Podpořte nás" (stránka zůstává, odkaz je v patičce).
// Položka s "deti" je rozbalovací skupina; aktivní je, když je aktivní některé její dítě.
const menu = PO_VOLBACH ? [
  { id: 'uvod',      text: 'Úvod',         href: u('index.html') },
  { id: 'volby',     text: 'Volby 2026',   deti: [
    { id: 'program',   text: 'Program',    href: u('program.html') },
    { id: 'javorovy',  text: '⛰️ Javorový', href: u('javorovy.html') },
    { id: 'kandidati', text: 'Kandidátka', href: u('kandidati.html') },
  ] },
  { id: 'vysledky',  text: 'Výsledky',     href: u('vysledky.html') },
  { id: 'zastupitelstvo', text: 'Zastupitelstvo', href: u('zastupitelstvo.html') },
] : [
  { id: 'uvod',      text: 'Úvod',         href: u('index.html') },
  { id: 'program',   text: 'Program',      href: u('program.html') },
  { id: 'vysledky',  text: 'Výsledky',     href: u('vysledky.html') },
  { id: 'kandidati', text: 'Kandidáti',    href: u('kandidati.html') },
  { id: 'javorovy',  text: '⛰️ Javorový',  href: u('javorovy.html'), cervena: true },
  { id: 'podporte',  text: 'Podpořte nás', href: u('podporte-nas.html') },
];
const udalostFB = 'https://www.facebook.com/events/2134356773779029/';
---
<header class="site-header">
  <div class="container">
    <a class="logo" href={u('index.html')} aria-label="Osobnosti pro Třinec — úvod">
      <img src={u('assets/logo.svg')} alt="Osobnosti pro Třinec">
    </a>
    <nav class="nav" id="nav">
      {menu.map(p => p.deti ? (
        <div class:list={['nav-skupina', { active: p.deti.some(d => d.id === active) }]}>
          <button type="button" class="nav-skupina-btn" aria-haspopup="true" aria-expanded="false"
                  onclick="var s=this.parentNode.classList.toggle('open');this.setAttribute('aria-expanded',s)">
            {p.text}
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5"/></svg>
          </button>
          <div class="nav-pod">
            {p.deti.map(d => <a href={d.href} class:list={[{ active: active === d.id }]}>{d.text}</a>)}
          </div>
        </div>
      ) : (
        <a href={p.href} class:list={[{ active: active === p.id, 'nav-red': p.cervena }]}>{p.text}</a>
      ))}
    </nav>
    <div class="header-right">
      {/* Po volbách (PO_VOLBACH v src/lib/verejne.js) místo výzvy k volbě odkaz na děkovný blok. */}
      {PO_VOLBACH
        ? <a class="btn btn-blue header-cta" href={u('index.html#dekujeme')}>Děkujeme</a>
        : <a class="btn btn-blue header-cta" href={udalostFB} target="_blank" rel="noopener">Volte č. 3</a>}
      <button class="nav-toggle" aria-label="Menu" onclick="document.getElementById('nav').classList.toggle('open')">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
  </div>
</header>
<script is:inline>
  // Rozbalovací skupina v menu: klepnutí mimo ni ji zavře (otevření řeší onclick na tlačítku a :hover v CSS).
  document.addEventListener('click', function (e) {
    document.querySelectorAll('.nav-skupina.open').forEach(function (s) {
      if (!s.contains(e.target)) { s.classList.remove('open'); s.querySelector('button').setAttribute('aria-expanded', 'false'); }
    });
  });
</script>
