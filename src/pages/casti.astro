---
// Programová pasáž k příměstským částem (září 2026).
// Vznikla z bodu ze schůzky 9. 9.: „podpora městských částí v programu je,
// ale málo viditelně → zvážit vlastní pasáž.“
// Data: casti.js (obyvatelé + kapitálové výdaje 2022–2025 ze závěrečných účtů).
// Tón je věcný — nejde o obvinění vedení, ale o narovnání rozdílů mezi částmi.
import Base from '../layouts/Base.astro';
import { u } from '../lib/url.js';
import {
  casti, naObyvatele, souhrn, souhrnZanedbanych, zanedbane, zavazky, OBDOBI,
} from '../data/casti.js';

const cislo = new Intl.NumberFormat('cs-CZ');
const procenta = (x) => `${new Intl.NumberFormat('cs-CZ', { maximumFractionDigits: 1 }).format(x * 100)} %`;
const miliony = (x) => `${new Intl.NumberFormat('cs-CZ', { maximumFractionDigits: 1 }).format(x / 1e6)} mil.`;

// Pořadí grafu: od nejvyšší částky na obyvatele po nulu.
const zebricek = [...casti].sort((a, b) => naObyvatele(b) - naObyvatele(a));
const maximum = naObyvatele(zebricek[0]);
const sirka = (c) => Math.max(naObyvatele(c) / maximum * 100, 0.6);

// Malá čísla se v textu píšou slovem; v grafu a ve statistikách zůstávají číslicí.
const SLOVY = ['nula', 'jedna', 'dvě', 'tři', 'čtyři', 'pět', 'šest', 'sedm', 'osm', 'devět'];
const slovy = (n) => SLOVY[n] ?? String(n);

const vyjmenuj = (pole) =>
  pole.length < 2 ? pole.join('')
  : `${pole.slice(0, -1).join(', ')} a ${pole[pole.length - 1]}`;

const udalostFB = 'https://www.facebook.com/events/2134356773779029/';
---
<Base
  title="Příměstské části — Osobnosti pro Třinec"
  description={`V ${souhrn.pocetPrimestskych} příměstských částech Třince žije ${procenta(souhrn.podilObyvatel)} obyvatel a šlo do nich ${procenta(souhrn.podilInvestic)} investic města ${OBDOBI}. Co s tím chceme udělat: místa k setkávání, doprava na zavolání, bezpečné cesty do centra a přehled, na který každý vidí.`}
  path="casti.html"
  active="program"
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Program 2026 · části města</p>
      <h1>Třinec nekončí<br>za <span class="hl">sídlištěm</span>.</h1>
      <p class="hero-lead">
        Guty, Nebory, Oldřichovice, Kanada, Karpentná, Kojkovice, Osůvky, Tyra,
        Horní Líštná, Konská s Podlesím — v příměstských částech bydlí
        {' '}{procenta(souhrn.podilObyvatel)} Třinečanů. Podívali jsme se, kolik do nich
        za poslední čtyři roky šlo, a co je potřeba narovnat.
      </p>
      <div class="stat-links">
        <a class="btn btn-secondary" href="#zavazky">Co uděláme</a>
        <a class="btn btn-secondary" href={u('program.html')}>Celý program</a>
      </div>
    </div>
  </section>

  <!-- ================= Čísla ================= -->
  <section class="section" id="cisla">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Fakta · {OBDOBI}</p>
        <h2>Kam šly <span class="hl">investice</span> města.</h2>
        <p class="section-note">
          {miliony(souhrn.investiceCelkem)} Kč kapitálových výdajů, které se dají
          přiřadit konkrétní části. Celoměstské stavby za {miliony(381525689)} Kč —
          kino, nadjezd, semafory, lesopark — v grafu nejsou; slouží celému městu.
        </p>
      </div>

      <div class="casti-cisla">
        <div class="casti-cislo">
          <span class="casti-cislo-hodnota">{procenta(souhrn.podilObyvatel)}</span>
          <span class="casti-cislo-popis">obyvatel Třince bydlí v příměstských částech</span>
        </div>
        <div class="casti-cislo">
          <span class="casti-cislo-hodnota">{procenta(souhrn.podilInvestic)}</span>
          <span class="casti-cislo-popis">investic {OBDOBI} do nich zamířilo</span>
        </div>
        <div class="casti-cislo">
          <span class="casti-cislo-hodnota">{zanedbane.filter(c => c.investice === 0).length}</span>
          <span class="casti-cislo-popis">
            části nedostaly ani korunu — {vyjmenuj(zanedbane.filter(c => c.investice === 0).map(c => c.nazev))}
          </span>
        </div>
      </div>

      <ol class="casti-graf">
        {zebricek.map(c => (
          <li class={`casti-radek${c.typ === 'sidliste' ? ' je-sidliste' : ''}${c.investice === 0 ? ' je-nula' : ''}`}>
            <span class="casti-nazev">
              {c.nazev}
              <span class="casti-obyvatel">{cislo.format(c.obyvatel)} obyvatel</span>
            </span>
            <span class="casti-pruh" aria-hidden="true"><span style={`width:${sirka(c)}%`}></span></span>
            <span class="casti-hodnota">
              {cislo.format(naObyvatele(c))} Kč
              <span class="casti-hodnota-popis">na obyvatele</span>
            </span>
            <span class="casti-akce">{c.akce}</span>
          </li>
        ))}
      </ol>
      <p class="section-note">
        Šedé řádky jsou sídliště, tmavé příměstské části. Průměr celého města je
        {' '}{cislo.format(souhrn.prumerNaObyvatele)} Kč na obyvatele.
      </p>
    </div>
  </section>

  <!-- ================= Co z toho plyne ================= -->
  <section class="section casti-vyklad">
    <div class="container">
      <h2>Rozdíl není centrum <span class="hl">versus</span> vesnice.</h2>
      <div class="casti-vyklad-text">
        <p>
          Nejvyšší částku na obyvatele dostala Tyra a hned za ní Konská s Podlesím —
          obojí příměstské části. Vodovod, chodník nebo most jsou drahé stavby
          a v malé části se rozpočítají na málo lidí. Tvrdit, že město na venkov
          zapomíná, by tedy nebylo poctivé.
        </p>
        <p>
          Skutečný rozdíl je jinde: mezi částmi, které dostaly jeden velký projekt,
          a částmi, kde se za čtyři roky nestalo prakticky nic.
          {' '}{slovy(souhrnZanedbanych.pocet).replace(/^./, z => z.toUpperCase())} částí —
          {' '}{vyjmenuj(zanedbane.map(c => c.nazev))} — má dohromady
          {' '}{cislo.format(souhrnZanedbanych.obyvatel)} obyvatel,
          tedy {procenta(souhrnZanedbanych.podilObyvatel)} Třince, a dostalo
          {' '}{procenta(souhrnZanedbanych.podilInvestic)} investic.
          Kanada s tisícovkou obyvatel a Horní Líštná neměly za čtyři roky
          jedinou investiční akci.
        </p>
        <p>
          Nejde o to přesunout peníze ze sídlišť. Jde o to, aby žádná část
          nezůstala celé volební období mimo hru — a aby to bylo předem vidět.
        </p>
      </div>
    </div>
  </section>

  <!-- ================= Závazky ================= -->
  <section class="section" id="zavazky">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Program</p>
        <h2>Co pro části <span class="hl">uděláme</span>.</h2>
        <p class="section-note">
          Šest závazků, které platí pro všechny části stejně — ne seznam slibů
          rozdaných po vesnicích podle toho, kde máme nejvíc hlasů.
        </p>
      </div>

      <div class="promises casti-zavazky">
        {zavazky.map((z, i) => (
          <article class="promise">
            <p class="promise-index">{String(i + 1).padStart(2, '0')}</p>
            <h3>{z.nazev}</h3>
            <p class="casti-zavazek-text">{z.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= Metodika ================= -->
  <section class="section casti-metodika">
    <div class="container">
      <details class="area-vize">
        <summary>
          <span>Odkud čísla jsou</span>
          <span class="area-vize-plus">+</span>
        </summary>
        <div class="casti-metodika-text">
          <p>
            Zdrojem jsou závěrečné účty města Třince za roky 2022 až 2024, návrh
            závěrečného účtu za rok 2025 (přílohy kapitálových výdajů) a počty
            obyvatel ze sčítání lidu 2021. Zpracovali jsme je sami.
          </p>
          <ul>
            <li>
              Jde o <strong>investice, ne o opravy</strong> z běžných výdajů. Část,
              která nemá žádnou investici, mohla dostat běžnou údržbu — sekání,
              opravu výtluků, úklid. „Nula“ platí pro investice, ne pro veškerou péči.
            </li>
            <li>
              <strong>Celoměstské stavby</strong> za {miliony(381525689)} Kč — kino Kosmos,
              nadjezd na Závodní, první základní škola, semafory, lesopark — jsme
              vyčlenili. Stojí většinou na sídlištích, ale používá je celé město.
            </li>
            <li>
              <strong>Školy</strong> jsou započtené podle místa budovy, i když mají
              širší spád. Po jejich odečtení je rozdíl mezi sídlišti a příměstskými
              částmi na obyvatele prakticky nulový.
            </li>
            <li>
              <strong>Zařazení akce k části</strong> je naše klasifikace podle názvu
              v rozpočtu, ne oficiální členění. Lyžbice a Staré Město jsme sloučili,
              Podlesí spadá statisticky pod Konskou, Sosna pod Dolní Líštnou.
            </li>
            <li>
              <strong>Čtyřleté okno je arbitrární.</strong> Část, která dostala velkou
              investici v roce 2021 nebo ji dostane v roce 2027, v tomto řezu vypadá
              hůř, než odpovídá skutečnosti.
            </li>
          </ul>
          <p>
            Našli jste v číslech chybu? Napište nám — opravíme to a napíšeme, co se
            změnilo.
          </p>
        </div>
      </details>
    </div>
  </section>

  <section class="section section-cta-band">
    <div class="container">
      <h2><span class="hl">Srdcem</span> pro Třinec.</h2>
      <p class="section-note">Volby do zastupitelstva Třince se konají 9.–10. října 2026.</p>
      <div class="section-cta stat-links" style="justify-content:center">
        <a class="btn btn-secondary btn-lg" href={u('program.html')}>Celý program</a>
        <a class="btn btn-blue btn-lg" href={udalostFB} target="_blank" rel="noopener">Chci volit!</a>
      </div>
    </div>
  </section>
</Base>
