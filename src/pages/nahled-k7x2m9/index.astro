---
// ROZCESTNÍK SKRYTÉHO NÁHLEDU — interní kontrola stránek, které jsou hotové,
// ale zatím nejsou veřejně publikované (viz src/lib/rezim.js).
// Stránka není nikde prolinkovaná, není v sitemapě a má noindex.
//
// Pravidlo obsahu (3. 9. 2026, rozhodnutí Adama): patří sem POUZE zpracované
// a nepublikované stránky. Kandidátka i medailonky jsou od 26. 8. živé na webu
// (viz PLNA_KANDIDATKA a REZIM_MEDAILONKU v src/lib/verejne.js), proto tady
// už nejsou. Pracovní pomůcky (mapa webu, fotobanka, kontrolní tabulka
// medailonků) zůstávají na svých adresách, jen se sem nelinkují.
import Base from '../../layouts/Base.astro';
import { u } from '../../lib/url.js';
---
<Base
  title="Interní náhled — Osobnosti pro Třinec"
  description="Rozcestník hotových, zatím nepublikovaných stránek."
  path="nahled-k7x2m9.html"
  noindex={true}
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Interní náhled — nesdílet</p>
      <h1>Hotové stránky, <span class="hl">které ještě nejsou venku</span>.</h1>
      <p class="hero-lead">
        Tady jsou plné verze stránek a rozepsané články, které zatím nejsou
        veřejné. Odkaz na tuto stránku prosím nešiřte — stránky nejsou v menu
        ani v sitemapě a mají zakázanou indexaci, ale kdo zná adresu, ten je
        uvidí.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Nepublikované stránky</h2>
      </div>
      <ul class="area-list">
        <li><a href={u('nahled-k7x2m9/program.html')}>Program 2026 — kompletní (závazky, vize, PDF)</a></li>
        <li><a href={u('nahled-k7x2m9/program-osobnosti-pro-trinec-2026.pdf')}>Program 2026 — PDF ke stažení</a></li>
        <li><a href={u('nahled-k7x2m9/javorovy.html')}>Javorový 2.0 — celá vize</a></li>
      </ul>

      <div class="section-head" style="margin-top:2rem">
        <h2>Články — pracovní verze</h2>
      </div>
      <ul class="area-list">
        <li><a href={u('blog-je-v-trinci-mrtvo-nebo-zivo.html')}>Je v Třinci mrtvo, nebo živo? — draft (chybí pár bloků a reels)</a></li>
        <li><a href={u('nahled-k7x2m9/blog-sdilene-kancelare.html')}>Třinec potřebuje místo, kde se potkají lidé s nápady — sdílené kanceláře a podnikavost (DRAFT v0.1)</a></li>
      </ul>
    </div>
  </section>
</Base>
