---
import Base from '../../layouts/Base.astro';
import { u } from '../../lib/url.js';
---
<Base
  title="Javorový — nová vize | Osobnosti pro Třinec"
  description="Rok práce, stovky hlasů, jeden kopec. Co dál s Javorovým — průzkum, historie chaty a konkrétní kroky po volbách."
  path="nahled-k7x2m9/javorovy.html"
  noindex={true}
  active=""
>
  <style is:inline>
    /* Doplňkové styly jen pro tuto podstránku — tokeny z style.css */
    .jv-hero-grid {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: var(--s-64);
      align-items: center;
    }
    .jv-hero-grid--top { align-items: start; }
    @media (max-width: 900px) { .jv-hero-grid { grid-template-columns: 1fr; } }
    /* Cover — titulek na fotce (magazínová obálka) */
    .jv-cover {
      position: relative;
      min-height: 640px;
      display: flex;
      align-items: flex-end;
      overflow: hidden;
      /* clip-path vytvoří kontejner pro position:fixed → fotka drží na místě, stránka po ní sjíždí */
      clip-path: inset(0);
    }
    .jv-cover-bg {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      object-fit: cover;
      object-position: center center;
      z-index: 0;
      /* kolorování: potlačíme původní barevnost, ať sedne modrý nádech */
      filter: saturate(0.45) contrast(1.08) brightness(0.94);
    }
    /* kolorování — modrý nádech přes fotku (duotón) */
    .jv-cover-tint {
      position: absolute;
      inset: 0;
      z-index: 1;
      background: var(--signal-blue);
      mix-blend-mode: color;
      opacity: 0.72;
    }
    .jv-cover-shade {
      position: absolute;
      inset: 0;
      z-index: 1;
      background:
        linear-gradient(180deg, rgba(30,30,30,0.10) 0%, rgba(30,30,30,0.30) 40%, rgba(30,30,30,0.80) 100%),
        linear-gradient(90deg, rgba(30,30,30,0.45) 0%, rgba(30,30,30,0.05) 70%);
    }
    .jv-cover .container {
      position: relative;
      z-index: 2;
      padding-top: 160px;
      padding-bottom: var(--s-64);
    }
    .jv-cover h1 { color: #fff; }
    .jv-cover-eyebrow {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: rgba(255,255,255,0.85);
      margin-bottom: var(--s-16);
    }
    .jv-cover-lead {
      color: rgba(255,255,255,0.94);
      font-size: 19px;
      line-height: 1.55;
      max-width: 58ch;
      margin-top: var(--s-24);
    }
    @media (max-width: 900px) {
      .jv-cover { min-height: 440px; clip-path: none; }
      .jv-cover .container { padding-top: 100px; }
      /* na mobilu fixed pozadí trhá (iOS), vracíme klasické */
      .jv-cover-bg { position: absolute; width: 100%; height: 100%; }
    }
    .jv-toc-section { padding-top: var(--s-64); padding-bottom: var(--s-40); }
    .jv-toc-2col {
      max-width: none;
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: var(--s-64);
      border-top: none;
    }
    .jv-toc-2col a { border-top: 1px solid var(--border); border-bottom: none; }
    @media (max-width: 800px) { .jv-toc-2col { grid-template-columns: 1fr; } }
    .jv-caption {
      font-size: 14px;
      color: var(--text-muted);
      margin-top: var(--s-8);
    }
    .timeline { max-width: 820px; }
    .timeline-row {
      display: flex;
      gap: var(--s-24);
      padding: var(--s-16) 0;
      border-bottom: 1px solid var(--border);
      align-items: baseline;
    }
    .timeline-row:last-child { border-bottom: none; }
    .timeline-date {
      font-family: var(--font-display);
      font-weight: 800;
      color: var(--signal-blue);
      min-width: 96px;
      flex-shrink: 0;
    }
    .timeline-text { color: var(--text-secondary); }
    .datarows { max-width: 820px; }
    .datarow {
      display: flex;
      gap: var(--s-24);
      padding: var(--s-16) 0;
      border-bottom: 1px solid var(--border);
      align-items: baseline;
    }
    .datarow:last-child { border-bottom: none; }
    .datarow-num {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 32px;
      color: var(--signal-blue);
      min-width: 110px;
      flex-shrink: 0;
      line-height: 1;
    }
    .datarow-text { color: var(--text-secondary); }
    .bars { max-width: 820px; }
    .bar-item { margin-bottom: var(--s-24); }
    .bar-label { margin-bottom: var(--s-8); }
    .bar-fill {
      background: var(--signal-blue);
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      padding-right: var(--s-16);
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 16px;
      color: #fff;
    }
    .jv-viz img { width: 100%; border-radius: 8px; }
    /* Historie jako vložený „archivní" blok v obsahu */
    .jv-history-clip {
      background: #f7f3ec;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: var(--s-40);
    }
    .jv-history-clip .jv-viz img { border: 1px solid var(--border); }
    #historie.section { padding-top: 0; }
    /* Nadpis nad kroky */
    .steps-title { font-size: 24px; margin-bottom: var(--s-40); }
    .jv-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--s-40);
    }
    .stat .section-head { margin-bottom: var(--s-40); }
    @media (max-width: 800px) {
      .jv-stats { gap: var(--s-16); }
      .jv-stat-num { font-size: 40px; }
      .jv-stat p { font-size: 14px; }
    }
    .jv-stat-num {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 64px;
      line-height: 1;
      color: var(--signal-blue);
      margin-bottom: var(--s-8);
    }
    .jv-stat p { color: var(--text-secondary); max-width: 30ch; }
    .approach { border-top: 1px solid var(--border); padding-top: var(--s-16); }
    .approach-meta {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 14px;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: var(--s-8);
    }
    .approach-pick {
      display: inline-block;
      background: var(--signal-blue);
      color: #fff;
      border-radius: 999px;
      padding: 2px 12px;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: var(--s-8);
    }
    .jv-band {
      background: var(--brand-red);
      color: #fff;
      padding: var(--s-96) 0;
    }
    .jv-band-eyebrow {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      opacity: 0.85;
      margin-bottom: var(--s-16);
    }
    .jv-band h2 {
      color: #fff;
      font-size: clamp(32px, 5vw, 48px);
      margin-bottom: var(--s-16);
    }
    .jv-band p { max-width: 62ch; opacity: 0.95; }
    /* Horizontální timeline a kroky (DTP sloupce) */
    .timeline-h {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: var(--s-40);
    }
    @media (max-width: 900px) {
      .timeline-h { grid-template-columns: 1fr 1fr; }
      .timeline-h .tl-col:last-child { grid-column: 1 / -1; }
    }
    .tl-col { border-top: 1px solid var(--border); padding-top: var(--s-16); }
    .tl-date {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 20px;
      color: var(--signal-blue);
      margin-bottom: var(--s-8);
    }
    .tl-col p { font-size: 15px; color: var(--text-secondary); }
    .steps-h {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--s-40);
    }
    @media (max-width: 900px) { .steps-h { grid-template-columns: 1fr 1fr; } }
    .steps-h .step-col { border-top: 1px solid var(--border); padding-top: var(--s-16); }
    .steps-h .step-num-h {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 28px;
      color: var(--signal-blue);
      margin-bottom: var(--s-8);
    }
    .steps-h p { font-size: 15px; color: var(--text-secondary); }
    /* Průzkum ve dvou sloupcích */
    .jv-pruzkum-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--s-64) var(--s-96);
      align-items: start;
    }
    @media (max-width: 900px) { .jv-pruzkum-grid { grid-template-columns: 1fr; } }
    .jv-col-label {
      font-family: var(--font-display);
      font-weight: 800;
      text-transform: uppercase;
      font-size: 18px;
      margin-bottom: var(--s-24);
    }
    /* Pás s fotkou na pozadí */
    .jv-band-photo {
      position: relative;
      padding: 120px 0;
      color: #fff;
      overflow: hidden;
    }
    .jv-band-photo .band-bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .jv-band-photo .band-shade {
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, rgba(35,35,35,0.88) 0%, rgba(35,35,35,0.72) 55%, rgba(35,35,35,0.5) 100%);
    }
    .jv-band-photo .container { position: relative; z-index: 2; }
    .jv-band-photo h2 { color: #fff; font-size: clamp(32px, 5vw, 48px); margin-bottom: var(--s-16); }
    .jv-band-photo p { max-width: 58ch; opacity: 0.95; }
    .btn-white {
      background: var(--paper);
      color: var(--anthracite);
    }
    .btn-white:hover { background: rgba(255,255,255,0.86); }
    /* Doporučení — červený box */
    .rec-box {
      background: var(--brand-red);
      color: #fff;
      padding: var(--s-64);
      margin-top: var(--s-64);
    }
    @media (max-width: 700px) { .rec-box { padding: var(--s-40) var(--s-24); } }
    .rec-label {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      opacity: 0.85;
      margin-bottom: var(--s-24);
    }
    .rec-claim {
      font-family: var(--font-display);
      font-weight: 800;
      text-transform: uppercase;
      font-size: clamp(30px, 4.2vw, 46px);
      line-height: 1.0;
      color: #fff;
      margin-bottom: var(--s-8);
    }
    .rec-sub {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: clamp(18px, 2vw, 24px);
      text-transform: uppercase;
      color: rgba(255,255,255,0.9);
      margin-bottom: var(--s-24);
    }
    .rec-text {
      font-size: 17px;
      line-height: 1.6;
      max-width: 68ch;
      color: rgba(255,255,255,0.95);
    }
    .rec-text + .rec-text { margin-top: var(--s-16); }
    /* Co dnes chybí */
    .wishes-block { margin-top: var(--s-64); }
    .wishes-head {
      font-family: var(--font-display);
      font-weight: 800;
      text-transform: uppercase;
      font-size: clamp(20px, 2.2vw, 26px);
      margin-bottom: var(--s-24);
      max-width: 34ch;
    }
    .wishes {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0 var(--s-64);
    }
    @media (max-width: 900px) { .wishes { grid-template-columns: 1fr 1fr; gap: 0 var(--s-40); } }
    @media (max-width: 600px) { .wishes { grid-template-columns: 1fr; } }
    .wish {
      position: relative;
      padding: 13px 0 13px 28px;
      border-bottom: 1px solid var(--border);
      font-size: 16px;
      color: var(--text-secondary);
    }
    .wish::before {
      content: "+";
      position: absolute;
      left: 0;
      font-family: var(--font-display);
      font-weight: 800;
      color: var(--signal-blue);
    }
    /* celý blok „Proti čemu budeme bojovat" v jedné ploše */
    .against-block {
      background: rgba(50, 50, 50, 0.04);
      padding: var(--s-64);
      border-top: 3px solid var(--brand-red);
    }
    @media (max-width: 700px) { .against-block { padding: var(--s-40) var(--s-24); } }
    .against-block .wish { border-bottom-color: rgba(50, 50, 50, 0.12); }
    .against-block .note-block {
      background: var(--paper);
      padding: var(--s-24);
      border-left: 3px solid var(--brand-red);
    }
    /* proti čemu budeme bojovat — červené × místo modrého + */
    .wishes--against { grid-template-columns: repeat(2, 1fr); }
    @media (max-width: 600px) { .wishes--against { grid-template-columns: 1fr; } }
    .wishes--against .wish::before { content: "×"; color: var(--brand-red); }
    .wishes--against .wish strong { color: var(--text); }
    /* datové odrážky a zdroje */
    .lyz-body { max-width: 900px; }
    .lyz-podnadpis {
      font-family: var(--font-display);
      font-weight: 800;
      text-transform: uppercase;
      font-size: clamp(20px, 2.2vw, 26px);
      margin: var(--s-64) 0 var(--s-16);
    }
    .note-facts { list-style: none; margin: var(--s-16) 0; }
    .note-facts li {
      position: relative;
      padding: 10px 0 10px 22px;
      border-bottom: 1px solid var(--border);
      font-size: 16px;
      line-height: 1.5;
      color: var(--text-secondary);
    }
    .note-facts li:last-child { border-bottom: none; }
    .note-facts li::before {
      content: "—";
      position: absolute;
      left: 0;
      color: var(--signal-blue);
      font-weight: 700;
    }
    .note-facts strong { color: var(--text); }
    .note-sources {
      margin-top: var(--s-16);
      font-size: 13px !important;
      color: var(--text-muted) !important;
    }
    /* Infografika — prstence */
    .rings {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--s-40);
    }
    @media (max-width: 900px) { .rings { grid-template-columns: 1fr 1fr; gap: var(--s-40) var(--s-24); } }
    .ring { text-align: center; margin: 0; }
    .ring-wrap {
      position: relative;
      width: 168px;
      max-width: 100%;
      margin: 0 auto var(--s-16);
    }
    .ring-wrap svg { width: 100%; height: auto; display: block; transform: rotate(-90deg); }
    .ring-track { fill: none; stroke: rgba(50,50,50,0.10); stroke-width: 9; }
    .ring-fill {
      fill: none;
      stroke: var(--signal-blue);
      stroke-width: 9;
      stroke-linecap: butt;
    }
    .ring-num {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 34px;
      color: var(--signal-blue);
      letter-spacing: -0.01em;
    }
    .ring figcaption {
      font-size: 15px;
      line-height: 1.45;
      color: var(--text-secondary);
      max-width: 24ch;
      margin: 0 auto;
    }
    /* Slider s citacemi */
    .jv-quotes { background: rgba(50,50,50,0.03); }
    .hlasy-grid {
      display: grid;
      grid-template-columns: 1fr 0.85fr;
      gap: var(--s-64);
      align-items: start;
    }
    @media (max-width: 900px) { .hlasy-grid { grid-template-columns: 1fr; gap: var(--s-40); } }
    .beseda { margin: 0; }
    .beseda img { width: 100%; border-radius: 8px; }
    .beseda figcaption { margin-top: var(--s-8); }
    .quote-slider { position: relative; max-width: 900px; }
    /* všechny citace leží v jedné buňce gridu → výška = nejdelší citace, nic neposkakuje */
    .quote-stage { display: grid; }
    .quote-slide {
      grid-area: 1 / 1;
      margin: 0;
      opacity: 0;
      visibility: hidden;
      transform: translateY(8px);
      transition: opacity 360ms cubic-bezier(0.4, 0, 0.2, 1),
                  transform 360ms cubic-bezier(0.4, 0, 0.2, 1),
                  visibility 0s linear 360ms;
    }
    .quote-slide.is-active {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }
    .quote-slide p {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: clamp(22px, 2.6vw, 32px);
      line-height: 1.3;
      color: var(--text);
      margin-bottom: var(--s-16);
    }
    .quote-slide footer {
      font-size: 15px;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-weight: 600;
    }
    .quote-nav { display: flex; gap: var(--s-8); margin-top: var(--s-40); }
    .quote-dot {
      width: 40px;
      height: 4px;
      border: none;
      padding: 0;
      background: rgba(50,50,50,0.16);
      cursor: pointer;
      transition: background 240ms var(--ease-ui);
    }
    .quote-dot.is-active { background: var(--brand-red); }
    .quote-dot:hover { background: rgba(50,50,50,0.36); }
    .quote-dot.is-active:hover { background: var(--brand-red); }
    .jv-toc { margin-top: var(--s-40); }
    .jv-toc-label {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
      margin-bottom: var(--s-16);
    }
    .jv-toc-links { max-width: 560px; border-top: 1px solid var(--border); }
    .jv-toc-links a {
      display: flex;
      align-items: baseline;
      gap: var(--s-16);
      padding: 13px 4px;
      border-bottom: 1px solid var(--border);
      font-size: 17px;
      color: var(--text);
      text-decoration: none;
      transition: color 240ms var(--ease-ui), background 240ms var(--ease-ui);
    }
    .jv-toc-links a .toc-num {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 15px;
      color: var(--signal-blue);
      min-width: 32px;
      flex-shrink: 0;
    }
    .jv-toc-links a:hover { color: var(--signal-blue); }
    .zadani {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0 var(--s-64);
      max-width: 1000px;
    }
    @media (max-width: 800px) { .zadani { grid-template-columns: 1fr; } }
    .zadani-item {
      display: flex;
      gap: var(--s-16);
      padding: var(--s-16) 0;
      border-bottom: 1px solid var(--border);
      align-items: baseline;
    }
    .zadani-item .check {
      color: var(--brand-red);
      font-weight: 800;
      font-size: 20px;
      flex-shrink: 0;
    }
    .zadani-item p { color: var(--text-secondary); font-size: 16px; }
    .zadani-item p strong { color: var(--text); }
    .jv-vize-areal { padding-top: var(--s-64); }
    .jv-vize-areal .section-head { margin-bottom: var(--s-40); }
    .jv-vize-lead {
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 21px;
      line-height: 1.45;
      color: var(--text);
      max-width: 56ch;
      margin-top: var(--s-16);
    }
    .zones { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-40); }
    @media (max-width: 800px) { .zones { grid-template-columns: 1fr; } }
    .zone-num {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 40px;
      color: var(--signal-blue);
      line-height: 1;
      margin-bottom: var(--s-8);
    }
    .zone h3 { font-size: 18px; margin-bottom: var(--s-8); }
    .zone p { color: var(--text-secondary); font-size: 15px; }
    .steps { max-width: 820px; counter-reset: krok; }
    .step-row {
      display: flex;
      gap: var(--s-24);
      padding: var(--s-16) 0;
      border-bottom: 1px solid var(--border);
      align-items: baseline;
    }
    .step-row:last-child { border-bottom: none; }
    .step-num {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 24px;
      color: var(--signal-blue);
      min-width: 56px;
      flex-shrink: 0;
      line-height: 1;
    }
    </style>

  <!-- ================= COVER ================= -->
  <section class="jv-cover">
    <img class="jv-cover-bg" src={u('assets/img/javorovy/vyhled-udoli.jpg')} alt="Výhled z Javorového na Třinec a údolí Olše">
    <div class="jv-cover-tint"></div>
    <div class="jv-cover-shade"></div>
    <div class="container">
      <h1>Javorový.<br><span class="hl">Nová vize.</span></h1>
      <p class="jv-cover-lead">
        Rok práce. Stovky hlasů. Jeden kopec. Z pověření zastupitelstva
        jsme připravili podklad pro rozhodnutí o budoucnosti chaty
        i celého areálu — a tady je, co jsme zjistili.
      </p>
    </div>
  </section>

  <!-- ================= OBSAH ================= -->
  <section class="section jv-toc-section">
