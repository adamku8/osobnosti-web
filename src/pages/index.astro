---
// Úvod: hero s billboardem a pod ním plný rozcestník webu — děkovný blok po volbách
// (počet hlasů, čtyři zvolení zastupitelé a celá kandidátka), slovo lídryně, čtyři
// programové oblasti s prokliky do /program.html, sedm projektů, výsledky, doporučení,
// Aktuálně ze sítí, Jak volit s odpočtem a závěrečný rozcestník.
// Styly jen pro úvod: src/styles/uvod.css.
// (Do 12. 9. 2026 byl úvod v teaser režimu jen s hero a bannerem — viz git.)
// (Do 5. 11. 2026 byl místo děkovného bloku blok „27" a níž sekce dvanácti kandidátů.)
// Co po volbách přestalo platit, schovává přepínač PO_VOLBACH v src/lib/verejne.js:
// billboard s kandidáty (hero je pak jen děkovné číslo, panorama se stěhuje pod
// zastupitele), slovo lídryně, program a projekty (jsou v menu pod „Volby 2026"),
// „Co se děje v kampani", upoutávka Výsledky 2022–2026 (stránka je v menu), upoutávka
// Doporučují nás, tlačítko Podpořte nás v závěru a Jak volit s odpočtem. Místo nich přibývají priority
// „Na čem nám záleží" (src/data/priority.js) a „Ze zastupitelstva" (src/lib/zapisy.js).
import Base from '../layouts/Base.astro';
import OblastKarta from '../components/OblastKarta.astro';
import SekceProjekty from '../components/SekceProjekty.astro';
import DekujemeCislo from '../components/DekujemeCislo.astro';
import PanoramaUvod from '../components/PanoramaUvod.astro';
import ZapisKarta from '../components/ZapisKarta.astro';
import { PRIORITY } from '../data/priority.js';
import { zapisy } from '../lib/zapisy.js';
import { oblasti } from '../data/oblasti.js';
import { kandidati } from '../data/kandidati.js';
import { medailonky } from '../data/medailonky.js';
import { aktualne, SOCIAL } from '../data/aktualne.js';
import { PO_VOLBACH } from '../lib/verejne.js';
import { VOLBY_2026, tisice } from '../data/volby2026.js';
import { u } from '../lib/url.js';
import '../styles/uvod.css';
import { uvodnik, CISLO, slibili, doporuceni } from '../data/noviny.js';
import '../styles/noviny.css';

// Děkovný blok: nahoře čtyři zvolení, pod nimi zbytek kandidátky (src/lib/tym.js;
// stejné bloky má i stránka Kdo jsme).
import { zvoleni, ostatni, hrefKandidata } from '../lib/tym.js';
import KartyZastupitelu from '../components/KartyZastupitelu.astro';
import MrizkaTymu from '../components/MrizkaTymu.astro';
// Jméno bez titulů („Mgr. Adam Kurzok" → „Adam Kurzok") pro odkazy v běžném textu.
const bezTitulu = (jmeno) => jmeno.split(',')[0].split(' ').filter(c => !c.endsWith('.')).join(' ');

// Ze zastupitelstva: na úvodu tři nejnovější zápisy, všechny jsou na /zastupitelstvo.html.
const vsechnyZapisy = zapisy();
const vsechZapisu = vsechnyZapisy.length;
const posledniZapisy = vsechnyZapisy.slice(0, 3);

// Volby do zastupitelstva: pátek 9. 10. 14:00–22:00, sobota 10. 10. 8:00–14:00.
// Odpočet dnů se dopočítá v prohlížeči; tady jen hodnota pro build (fallback).
const VOLBY_START = '2026-10-09T14:00:00+02:00';
const VOLBY_KONEC = '2026-10-10T14:00:00+02:00';
const dnuDoVoleb = Math.ceil((new Date('2026-10-09T00:00:00+02:00') - new Date()) / 86400000);
const udalostFB = 'https://www.facebook.com/events/2134356773779029/';
---
<Base
  title="Osobnosti pro Třinec — Nové vize. Nový Třinec. Osobnosti."
  description={PO_VOLBACH
    ? `Lokální občanské hnutí Osobnosti pro Třinec. V komunálních volbách 2026 jsme získali ${tisice(VOLBY_2026.hlasy)} hlasů a čtyři místa v zastupitelstvu. Děkujeme.`
    : 'Lokální občanské hnutí Osobnosti pro Třinec. Sedmadvacet osobností, které v Třinci doopravdy žijí a pracují. Komunální volby 9.–10. října 2026.'}
  path=""
  active="uvod"
>
  <script is:inline>document.documentElement.classList.add('js');</script>

  <!-- ================= HERO — billboard ================= -->
  <section class:list={['hero', 'hero-bb', PO_VOLBACH && 'dk']} id="uvod">
    <div class="container">
      {/* Claim nese sám billboard, H1 zůstává jen pro čtečky a vyhledávače. */}
      <h1 class="sr-only">{PO_VOLBACH ? 'Osobnosti pro nový Třinec' : 'Osobnosti pro nový Třinec — komunální volby 9.–10. října 2026'}</h1>

      {PO_VOLBACH ? (
        /* Po volbách je hero jen děkovné číslo s grafikou mandátů. Billboard s kandidáty
           a text pod ním jsou schované, panorama je pod zastupiteli (pokyn Adama, 5. 11. 2026). */
        <DekujemeCislo id="dekujeme" class="dk-hero" />
      ) : (
        <Fragment>
      <picture class="hero-billboard">
        <source media="(max-width: 700px)" srcset={u('assets/img/hero-billboard-1200.jpg')}>
        <img
          src={u('assets/img/hero-billboard.jpg')}
          alt="Kandidáti hnutí Osobnosti pro Třinec s heslem „Osobnosti pro… Nový Třinec!“"
          width="1720" height="914" fetchpriority="high">
      </picture>

      <div class="hero-below">
        <p class="hero-lead">
          Doktoři, učitelé, podnikatelé, sportovci, současní zastupitelé.
          Osobnosti, které v Třinci doopravdy žijí a pracují.
          Přečtěte si <a href="#program">náš program</a> a poznejte <a href="#kandidati">naše kandidáty</a>.
        </p>
        <div class="hero-vote">
          <div>
            <div class="hero-date-label">Volby do zastupitelstva</div>
            <div class="hero-date">9.–10. října 2026</div>
          </div>
          <a class="btn btn-blue" href="#jak-volit">Jak volit</a>
        </div>
      </div>
        </Fragment>
      )}
    </div>

    {/* Panorama jako podlaha hera (princip 06). Po volbách je až pod zastupiteli. */}
    {!PO_VOLBACH && <PanoramaUvod />}
  </section>

  <!-- ================= DĚKUJEME — výsledek voleb 2026 (src/data/volby2026.js) =================
       Nahradil blok „27 / Sedmadvacet osobností" a sekci dvanácti kandidátů (5. 11. 2026).
       Jediná červená na ploše je číslo s počtem hlasů; modrá nese štítky zastupitelů. -->
  <section class="stat dk" id={PO_VOLBACH ? 'zastupitele' : 'dekujeme'}>
    <div class="container">
      {!PO_VOLBACH && <DekujemeCislo class="reveal" />}

      <div class="dk-head reveal" id="kandidati">
        <h3>Vaši zastupitelé <span class="dk-roky">2026–2030</span></h3>
      </div>
      <KartyZastupitelu />

    </div>
  </section>

  {/* Po volbách předěl s panoramatem mezi zastupiteli a zbytkem týmu. */}
  {PO_VOLBACH && <PanoramaUvod class="dk-pano" />}

  <section class:list={['stat', 'dk', !PO_VOLBACH && 'dk-navazuje']} id="tym">
    <div class="container">
      <div class="dk-head reveal">
        <h3>Celý tým, který do toho šel s námi</h3>
        <p class="section-note">
          Sedmadvacet osobností na jedné kandidátce. Klepnutím otevřete medailonek.
        </p>
      </div>
      <MrizkaTymu lide={ostatni} />
      <div class="cand-cta reveal">
        <a class="btn btn-secondary btn-lg" href={u('kandidati.html')}>Všech {kandidati.length} kandidátů</a>
      </div>
    </div>
  </section>

  {/* Slovo lídryně je předvolební úvodník — po volbách schované (pokyn Adama, 5. 11. 2026). */}
  {!PO_VOLBACH && (
  <Fragment>
  <!-- ================= SLOVO LÍDRYNĚ (volební noviny, strana 1) ================= -->
  <section class="section nv-uvodnik" id="slovo-lidryne">
    <div class="container nv-uvodnik-grid">
      <figure class="nv-uvodnik-foto reveal">
        <img src={u(uvodnik.foto)} alt="Lucie Fremrová se psem na trávníku" loading="lazy">
      </figure>
      <div class="nv-uvodnik-text reveal" style="--i:1">
        <p class="eyebrow" style="margin-bottom:var(--s-16)">Slovo lídryně</p>
        <h2 style="margin-bottom:var(--s-24)">Stejné hodnoty. <span class="hl">Nové</span> vize.</h2>
        <p class="nv-osloveni">{uvodnik.osloveni}</p>
        {uvodnik.odstavce.map((t, i) => (
          <p class:list={[i === uvodnik.odstavce.length - 1 && 'nv-pointa']}>{t}</p>
        ))}
        <div class="nv-podpis">
          <img src={u(uvodnik.podpis)} alt="" width="220" height="70" loading="lazy">
          <span>{uvodnik.jmeno}</span>
          <small>{uvodnik.role}</small>
        </div>
      </div>
    </div>
  </section>
  </Fragment>
  )}

  <!-- TÝMOVÁ FOTKA (Javorový, tym-2026-javorovy-v2.jpg) odstraněna 24. 9. 2026
       na pokyn Adama. Soubory zůstávají v public/assets/img/. -->

  {/* Program a projekty jsou po volbách jen v menu pod „Volby 2026" (pokyn Adama, 5. 11. 2026). */}
  {!PO_VOLBACH && (
  <Fragment>
  <!-- ================= PROGRAM — MŘÍŽKA OBLASTÍ (proklik do /program.html) ================= -->
  <section class="section" id="program">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Program 2026</p>
        <h2>Čtyři oblasti. Konkrétní závazky.</h2>
        <p class="section-note">
          U každé oblasti pět závazků — a projekty, které z nich chceme postavit.
          Vlastní pasáž má program pro <a href={u('casti.html')}>příměstské části</a>.
        </p>
      </div>
      <div class="promises">
        {oblasti.map((o, i) => (
          <OblastKarta o={o} href={u(`program.html#oblast-${o.cislo}`)} odkazText="Náš program →" bezCisla class="reveal" style={`--i:${i}`} />
        ))}
      </div>
      <div class="section-cta stat-links reveal" style="justify-content:center">
        <a class="btn btn-blue btn-lg" href={u('program.html')}>Celý program</a>
        <a class="btn btn-secondary btn-lg" href={u('assets/program-osobnosti-pro-trinec-2026.pdf')} target="_blank" rel="noopener">Stáhnout PDF</a>
      </div>
    </div>
  </section>

  <SekceProjekty cta={{ href: u('program.html#projekty'), text: 'Všechny projekty v programu' }} />
  </Fragment>
  )}

  <!-- ================= NA ČEM NÁM ZÁLEŽÍ — priority 2026–2030 (src/data/priority.js) ================= -->
  {PO_VOLBACH && (
  <section class="section" id="priority" style="border-top:1px solid var(--border)">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Naše priority 2026–2030</p>
        <h2>Na čem nám záleží.</h2>
      </div>
      <ul class="priority">
        {PRIORITY.map((p, i) => (
          <li class="reveal" style={`--i:${i}`}>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 12.5l5 5L20 6.5"/>
            </svg>
            <span>{p}</span>
          </li>
        ))}
      </ul>
      {/* Pod prioritami dvě výzvy: kde sledovat práci (Facebook) a komu napsat podnět
          (medailonky čtyř zastupitelů). Odkazy modře, červená na úvodu patří počtu hlasů. */}
      <div class="priority-dal reveal">
        <p>
          <strong>Sledujte, jak se nám daří.</strong>
          Průběžně o tom píšeme na <a href={SOCIAL.facebook} target="_blank" rel="noopener">naší facebookové stránce</a>.
        </p>
        <p>
          <strong>Máte podnět, co by město mělo řešit?</strong>
          Napište svému zastupiteli:{' '}
          {zvoleni.map((k, i) => (
            <Fragment>
              {hrefKandidata(k) ? <a class="priority-jmeno" href={hrefKandidata(k) + (k.email ? '#napiste' : '')}>{bezTitulu(k.jmeno)}</a> : bezTitulu(k.jmeno)}{i < zvoleni.length - 1 ? ', ' : '.'}
            </Fragment>
          ))}
        </p>
      </div>
    </div>
  </section>
  )}

  <!-- ================= ZE ZASTUPITELSTVA — poslední zápisy (src/lib/zapisy.js) ================= -->
  {PO_VOLBACH && (
  <section class="section" id="zastupitelstvo" style="border-top:1px solid var(--border)">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Zastupitelstvo města Třince</p>
        <h2>Ze zastupitelstva.</h2>
      </div>
      {/* Na úvodu jen odkazy (datum, název); shrnutí jsou na /zastupitelstvo.html. */}
      {posledniZapisy.length
        ? <ul class="zapisy">{posledniZapisy.map((z, i) => <ZapisKarta z={z} strucne class="reveal" style={`--i:${i}`} />)}</ul>
        : <p class="section-note reveal">První zápis přidáme po nejbližším zasedání.</p>}
      {vsechZapisu > posledniZapisy.length && (
        <div class="section-cta stat-links reveal" style="justify-content:center">
          <a class="btn btn-secondary btn-lg" href={u('zastupitelstvo.html')}>Všechny zápisy</a>
        </div>
      )}
    </div>
  </section>
  )}

  <!-- ================= VÝSLEDKY — upoutávka na /vysledky.html =================
       Po volbách z úvodu pryč (6. 11. 2026); stránka Výsledky zůstává v menu. -->
  {!PO_VOLBACH && (
  <section class="section" id="vysledky" style="border-top:1px solid var(--border)">
    <div class="container">
      <div class="section-head reveal" style="margin-bottom:var(--s-40)">
        <p class="eyebrow">Výsledky 2022–2026</p>
        <h2>Výsledky místo žvanění.</h2>
      </div>
      <div class="nv-cislo reveal">
        <div class="nv-cislo-hodnota">{CISLO.hodnota}</div>
        <div>
          <span class="nv-cislo-jednotka">{CISLO.jednotka} {CISLO.popis}</span>
          <p>Autobusové stanoviště, kino Kosmos, CirkArena, lesopark, mlžítka i nová dětská hřiště. Slušně, odborně a bez skandálů.</p>
        </div>
      </div>
      <ul class="nv-teaser-vysledky">
        {slibili.slice(0, 4).map((s, i) => (
          <li class="reveal" style={`--i:${i}`}>
            <a href={u(`vysledky.html#${s.id}`)}>
              <img src={u(s.foto)} alt={s.alt} loading="lazy">
              <span>{s.nazev}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="section-cta stat-links reveal" style="justify-content:center">
        <a class="btn btn-blue btn-lg" href={u('vysledky.html')}>Co jsme splnili</a>
      </div>
    </div>
  </section>
  )}

  {/* Předvolební doporučení jsou po volbách z úvodu pryč (pokyn Adama, 5. 11. 2026); stránka zůstává. */}
  {!PO_VOLBACH && (
  <Fragment>
  <!-- ================= DOPORUČUJÍ NÁS — upoutávka na /doporucuji-nas.html ================= -->
  <section class="section" id="doporucuji" style="border-top:1px solid var(--border)">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Doporučení</p>
        <h2>Doporučují nás třinecké <span class="hl">osobnosti</span>.</h2>
      </div>
      <ul class="nv-teaser-dop">
        {doporuceni.slice(0, 3).map((d, i) => (
          <li class="reveal" style={`--i:${i}`}>
            <div class="nv-teaser-dop-hlava">
              <img src={u(d.foto)} alt="" loading="lazy">
              <b>{d.jmeno}</b>
            </div>
            <p>„{d.kratce}“</p>
            <a class="link-more" href={u(`doporucuji-nas.html#${d.id}`)} style="margin-top:var(--s-16)">Celé doporučení →</a>
          </li>
        ))}
      </ul>
      <div class="section-cta stat-links reveal" style="justify-content:center">
        <a class="btn btn-secondary btn-lg" href={u('doporucuji-nas.html')}>Všech {doporuceni.length} doporučení</a>
      </div>
    </div>
  </section>
  </Fragment>
  )}

  {/* „Co se děje v kampani" je předvolební — po volbách schované (pokyn Adama, 5. 11. 2026). */}
  {!PO_VOLBACH && (
  <Fragment>
  <!-- ================= AKTUÁLNĚ — příspěvky ze sítí (src/data/aktualne.js) ================= -->
  <section class="section" id="aktualne">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Aktuálně</p>
        <h2>Co se děje v kampani.</h2>
        <p class="section-note">
          Poslední příspěvky z našeho Instagramu. Sledujte nás, ať vám nic neuteče.
        </p>
      </div>
      <div class="social-grid">
        {aktualne.map((p, i) => (
          <div class="social-item reveal" style={`--i:${i}`}>
            <iframe src={`https://www.instagram.com/${p.typ}/${p.id}/embed/`}
                    title="Příspěvek Osobnosti pro Třinec na Instagramu"
                    loading="lazy" scrolling="no" allowtransparency
                    allow="encrypted-media; picture-in-picture" allowfullscreen></iframe>
          </div>
        ))}
      </div>
      <div class="social-cta reveal">
        <a class="btn btn-secondary btn-lg" href={SOCIAL.instagram} target="_blank" rel="noopener">Instagram</a>
        <a class="btn btn-secondary btn-lg" href={SOCIAL.facebook} target="_blank" rel="noopener">Facebook</a>
      </div>
    </div>
  </section>
  </Fragment>
  )}

  {!PO_VOLBACH && (
  <Fragment>
  <!-- ================= JAK VOLIT + ODPOČET ================= -->
  <section class="section volit" id="jak-volit">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Volby 9.–10. října 2026</p>
        <h2>Jak volit <span class="hl">Osobnosti</span>?</h2>
        <p class="section-note">
          Do zastupitelstva Třince se volí 27 lidí a každý volič má 27 hlasů.
          Nejjednodušší a nejsilnější je dát je všechny nám — jedním křížkem.
        </p>
      </div>
      <div class="volit-grid">
        <div class="volit-cislo reveal">
          <svg class="vote-flower" viewBox="-10 -10 220 220" role="img" aria-label="Volte číslo 3">
            <g fill="#003B8E">
              <circle cx="100" cy="40" r="45"/>
              <circle cx="152" cy="70" r="45"/>
              <circle cx="152" cy="130" r="45"/>
              <circle cx="100" cy="160" r="45"/>
              <circle cx="48" cy="130" r="45"/>
              <circle cx="48" cy="70" r="45"/>
              <circle cx="100" cy="100" r="68"/>
            </g>
            <text x="100" y="78" text-anchor="middle" fill="#FFFFFF" font-family="Montserrat, 'Arial Black', sans-serif" font-weight="700" font-size="16" letter-spacing="1">VOLTE Č.</text>
            <text x="100" y="140" text-anchor="middle" fill="#FFFFFF" font-family="Montserrat, 'Arial Black', sans-serif" font-weight="800" font-size="68">3</text>
          </svg>
          <div class="volit-odpocet" id="odpocet" data-start={VOLBY_START} data-konec={VOLBY_KONEC}>
            <div class="volit-odpocet-num">{dnuDoVoleb > 0 ? dnuDoVoleb : '—'}</div>
            <div class="volit-odpocet-label">{dnuDoVoleb > 0 ? 'dní do voleb' : 'volby'}</div>
          </div>
        </div>
        <ol class="volit-kroky">
          <li class="volit-krok reveal" style="--i:0">
            <span class="volit-krok-n" aria-hidden="true">1</span>
            <div>
              <h3>Najděte na lístku číslo 3</h3>
              <p>Hlasovací lístek je jeden velký arch se všemi stranami. <strong>Osobnosti pro Třinec</strong> mají volební číslo 3.</p>
            </div>
          </li>
          <li class="volit-krok reveal" style="--i:1">
            <span class="volit-krok-n" aria-hidden="true">2</span>
            <div>
              <h3>Udělejte jeden křížek u názvu hnutí</h3>
              <p>Do rámečku u <strong>„Osobnosti pro Třinec“</strong> nahoře nad jmény. Tím dáte hlas všem 27 našim kandidátům najednou.</p>
            </div>
          </li>
          <li class="volit-krok reveal" style="--i:2">
            <span class="volit-krok-n" aria-hidden="true">3</span>
            <div>
              <h3>Nic dalšího nekřížkujte</h3>
              <p>Každý křížek u jména z jiné strany <strong>ubírá hlas našemu kandidátovi</strong> z konce listiny. Jeden křížek, plná síla.</p>
            </div>
          </li>
        </ol>
      </div>
      <p class="volit-hodiny reveal">
        Volební místnosti jsou otevřené v pátek 9. října od 14 do 22 hodin a v sobotu 10. října od 8 do 14 hodin.
        Volit můžete i s voličským průkazem — <a href={udalostFB} target="_blank" rel="noopener">připomínku najdete v události na Facebooku</a>.
      </p>
    </div>
  </section>
  </Fragment>
  )}

  <!-- ================= CLOSING ================= -->
  <section class="closing" id="podarilo">
    <img src={u('assets/img/panorama-udoli.jpg')} alt="Údolí Třince z Javorového" loading="lazy">
    <div class="closing-overlay">
      <div class="container">
        <h2 class="closing-claim reveal">S vaším hlasem <span class="hl">měníme</span> Třinec.</h2>
        <p class="closing-text reveal" style="--i:1">
          Již 20 let zastáváme hodnoty jako poctivost, odbornost a dobrou
          správu pro naše město, na které chceme navazovat — a zároveň
          prosazovat nové nápady a vize.
        </p>
        <nav class="closing-nav reveal" aria-label="Rozcestník" style="--i:2">
          <a href={u('program.html')}>Program</a>
          <a href={u('kandidati.html')}>Kandidáti</a>
          {!PO_VOLBACH && <a href="#jak-volit">Jak volit</a>}
          <a href="#kontakt">Kontakt</a>
        </nav>
        {/* Výzva k podpoře kampaně jen před volbami. */}
        {!PO_VOLBACH && (
          <div class="closing-cta reveal" style="--i:3">
            <a class="btn btn-blue btn-lg" href={u('podporte-nas.html')}>Podpořte nás</a>
          </div>
        )}
      </div>
    </div>
  </section>

  <script is:inline>
    // Odpočet do voleb — přepočítá se v prohlížeči (build může být starší).
    (function () {
      var el = document.getElementById('odpocet');
      if (!el) return;
      var start = new Date(el.dataset.start), konec = new Date(el.dataset.konec), ted = new Date();
      var num = el.querySelector('.volit-odpocet-num'), lab = el.querySelector('.volit-odpocet-label');
      if (ted >= konec) { num.textContent = '✓'; lab.textContent = 'volby skončily'; return; }
      if (ted >= start) { num.textContent = '!'; lab.textContent = 'volby právě probíhají'; return; }
      var pulnoc = new Date(start); pulnoc.setHours(0, 0, 0, 0);
      var d = Math.ceil((pulnoc - ted) / 86400000);
      if (d <= 0) { num.textContent = 'dnes'; lab.textContent = 'volby začínají ve 14:00'; return; }
      num.textContent = d;
      lab.textContent = d === 1 ? 'den do voleb' : d < 5 ? 'dny do voleb' : 'dní do voleb';
    })();

    // Vynořování sekcí při scrollu — bez JS zůstává vše viditelné (třída .js na <html>).
    (function () {
      var items = document.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window)) { items.forEach(function (i) { i.classList.add('is-in'); }); return; }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
      items.forEach(function (i) { io.observe(i); });
    })();
  </script>
</Base>
