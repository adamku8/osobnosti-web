---
// „Originál" — věcné srovnání našeho webu s webem hnutí NEZÁVISLÍ Třinec (září 2026).
// Tři dvojice výřezů: nahoře náš web, pod ním jejich. Žlutě zvýrazněné shodné pasáže
// vznikly strojově (Playwright), podklady drží ../../ANTI/srovnani-webu-nezavisli-2026-09-24/.
// Tón držíme věcný: žádný útok, jen data — kdo, co a kdy (brand voice §4, pravidlo 03).
import Base from '../layouts/Base.astro';
import { u } from '../lib/url.js';

// Před zveřejněním přepnout na false (stránka je do té doby noindex, v menu není).
const draft = true;

const IMG = 'assets/img/original/';
// Úplná statická kopie druhého webu (public/archiv/…), pořízená 24. 9. 2026
// skriptem mirror.py; originál zálohy leží v ANTI/…/zaloha-2026-09-24/.
const ARCHIV = 'archiv/nezavislitrinec-2026-09-24/index.html';
const ONI = 'https://www.nezavislitrinec.cz/';
const dvojice = [
  {
    id: 'novy-trinec', num: '01',
    nazev: 'Nový Třinec',
    hl: 'Nový Třinec',
    text: 'Deska „OSOBNOSTI PRO… NOVÝ TŘINEC!" je náš hlavní vizuál — na webu od 19. srpna, na billboardech, plakátech i v novinách. Druhý web má v hlavním titulku „Nezávislí lidé pro nový Třinec."',
    my: 'novy-osobnosti.jpg', oni: 'novy-nezavisli.jpg', detail: true,
    altMy: 'Deska z úvodu webu Osobnosti pro Třinec: červený pruh OSOBNOSTI PRO… a bílý pruh NOVÝ TŘINEC!',
    altOni: 'Hlavní titulek webu NEZÁVISLÍ Třinec: Nezávislí lidé pro nový Třinec.',
  },
  {
    id: 'slogan', num: '02',
    nazev: 'Stejné hodnoty. Nové vize.',
    hl: 'Nové vize.',
    text: 'Náš slogan je v patičce webu od 19. srpna a od září i na billboardech a v tisku. Na druhém webu stojí dvakrát na úvodní stránce, jen s dovětkem „Třinec".',
    my: '6-paticka-osobnosti.jpg', oni: '3-volby-box-nezavisli.jpg',
    altMy: 'Patička webu Osobnosti pro Třinec se sloganem Stejné hodnoty. Nové vize.',
    altOni: 'Úvodní stránka NEZÁVISLÍ Třinec s nadpisem Stejné hodnoty. Nové vize. Město, které nezůstane stát.',
  },
  {
    id: 'hero', num: '03',
    nazev: 'Doktoři, učitelé, podnikatelé…',
    hl: 'podnikatelé',
    text: 'Věta pod naším hlavním vizuálem je na webu od 10. srpna: „Doktoři, učitelé, podnikatelé, sportovci… Osobnosti, které v Třinci doopravdy žijí a pracují." Druhá verze: „Doktoři, učitelé, podnikatelé, trenéři. Lidé, kteří v Třinci opravdu žijí a pracují."',
    my: '2-hero-osobnosti.jpg', oni: '2-hero-nezavisli.jpg', detail: true,
    altMy: 'Úvod webu Osobnosti pro Třinec: šest kandidátů, deska Osobnosti pro… nový Třinec a věta Doktoři, učitelé, podnikatelé, sportovci, současní zastupitelé.',
    altOni: 'Úvod webu NEZÁVISLÍ Třinec: nadpis Nezávislí lidé pro nový Třinec a věta Doktoři, učitelé, podnikatelé, trenéři.',
  },
];

const sBoxem = (d) => {
  const i = d.nazev.indexOf(d.hl);
  return i < 0 ? { pred: d.nazev, box: null, za: '' }
    : { pred: d.nazev.slice(0, i), box: d.hl, za: d.nazev.slice(i + d.hl.length) };
};
---
<Base
  title="Originál — Osobnosti pro Třinec"
  description="Náš web běží od 19. srpna 2026. V září se objevil web dalšího hnutí se stejnou stavbou a stejnými větami. Těší nás to. Pro pořádek ukazujeme, co bylo první."
  path="original.html"
  active=""
  noindex={draft}
>
  <style is:inline>
    .orig-list { list-style: none; margin: 0; padding: 0; }
    .orig-item { padding: var(--s-64) 0; border-top: 1px solid rgba(50,50,50,.14); }
    .orig-item:first-child { border-top: 0; padding-top: 0; }
    .orig-head { display: grid; grid-template-columns: 72px minmax(0, 1fr); gap: var(--s-16); align-items: start; margin-bottom: var(--s-24); }
    .orig-num { font-family: var(--font-display); font-weight: 800; font-size: 20px; color: var(--brand-red); padding-top: 6px; }
    .orig-head h2 { margin: 0 0 var(--s-8); font-size: clamp(24px, 2.6vw, 34px); }
    .orig-head p { margin: 0; max-width: 62ch; color: rgba(50,50,50,.72); }

    .orig-pair { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-24); }
    .orig-pair figure { margin: 0; }
    .orig-pair figcaption {
      font-family: var(--font-display); font-weight: 600; font-size: 12px; letter-spacing: .12em;
      text-transform: uppercase; color: rgba(50,50,50,.55); margin-bottom: var(--s-8);
    }
    .orig-pair figcaption b { color: var(--anthracite); font-weight: 600; }
    .orig-pair figcaption a, .orig-stalo a { color: var(--signal-blue); text-decoration: none; border-bottom: 1px solid rgba(0,59,142,.35); }
    .orig-pair figcaption a:hover, .orig-stalo a:hover { color: #002a66; border-bottom-color: currentColor; }
    .orig-pair img { display: block; width: 100%; height: auto; border: 1px solid rgba(50,50,50,.14); border-radius: 4px; }
    .orig-pair--detail img { width: auto; max-width: 100%; }
    .orig-stalo { margin-top: var(--s-40); padding: var(--s-24); border: 1px solid rgba(50,50,50,.4); border-radius: 8px; max-width: 62ch; }
    .orig-stalo .eyebrow { margin-bottom: var(--s-8); }
    .orig-stalo p:not(.eyebrow) { margin: 0 0 var(--s-16); font-style: italic; }
    .orig-proc { margin-top: var(--s-64); }
    .orig-proc p:not(.eyebrow) { margin-bottom: 0; }
    .orig-note { margin-top: var(--s-16); font-size: 13px; color: rgba(50,50,50,.55); }

    @media (max-width: 760px) {
      .orig-pair { grid-template-columns: 1fr; }
      .orig-head { grid-template-columns: 48px minmax(0, 1fr); }
    }
  </style>

  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Kampaň 2026 · pro pořádek</p>
      <h1>Originál je <span class="hl">jen jeden</span>.</h1>
      <p class="hero-lead">
        Náš web běží od 19. srpna 2026. V září se objevil web dalšího třineckého hnutí
        se stejnou stavbou stránek a několika stejnými větami. Těší nás, že se náš
        přístup líbí. Pro pořádek ukazujeme, co bylo první.
      </p>
      <div class="orig-stalo">
        <p class="eyebrow">Co přesně se stalo</p>
        <p>
          Web <a href={ONI} target="_blank" rel="noopener nofollow"><strong>nezavislitrinec.cz</strong></a> nese podle svého serveru datum poslední
          změny <strong>21. září 2026</strong>. Dne <strong>24. září 2026</strong> jsme
          pořídili jeho úplnou kopii — všechny stránky, texty i obrázky, beze změn.
          Přesně tento obsah si můžete proklikat v naší archivní kopii.
        </p>
        <div class="stat-links">
          <a class="btn btn-secondary" href={u(ARCHIV)} target="_blank" rel="noopener nofollow">Otevřít archivní kopii webu</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ol class="orig-list">
        {dvojice.map(d => (
          <li class="orig-item" id={d.id}>
            <div class="orig-head">
              <span class="orig-num">{d.num}</span>
              <div>
                <h2>{sBoxem(d).pred}{sBoxem(d).box && <span class="hl">{sBoxem(d).box}</span>}{sBoxem(d).za}</h2>
                <p>{d.text}</p>
              </div>
            </div>
            <div class={`orig-pair${d.detail ? ' orig-pair--detail' : ''}`}>
              <figure>
                <figcaption><b>osobnostiprotrinec.cz</b> · od srpna 2026</figcaption>
                <img src={u(IMG + d.my)} alt={d.altMy} loading="lazy">
              </figure>
              <figure>
                <figcaption><a href={ONI} target="_blank" rel="noopener nofollow">nezavislitrinec.cz</a> · září 2026</figcaption>
                <img src={u(IMG + d.oni)} alt={d.altOni} loading="lazy">
              </figure>
            </div>
          </li>
        ))}
      </ol>
      <div class="orig-stalo orig-proc">
        <p class="eyebrow">Co se na 99 % stalo?</p>
        <p>
          Někdo u Nezávislých si řekl, že máme hezký web, vzal svůj AI nástroj a dal mu
          příkaz, „aby udělal podobný web jako OSOBNOSTI". A nezkontroloval si svou práci —
          převzala se totiž nejen struktura, ale i naše texty. Které jsme s AI netvořili,
          ale dali jsme si s nimi práci.
        </p>
      </div>
      <p class="orig-note">
        Snímky obou webů pořízené 24. září 2026. Shodné pasáže jsou podbarvené žlutě,
        jinak jsou stránky bez úprav. Data o našem webu jsou z historie jeho zdrojového kódu.
        Úplná kopie druhého webu ze dne 24. 9. 2026: <a href={u(ARCHIV)} target="_blank" rel="noopener nofollow">archivní kopie</a>.
      </p>
    </div>
  </section>

  <section class="section section-cta-band">
    <div class="container">
      <h2>Jsme rádi inspirací, ale volit je lepší <span class="hl">originál</span>.</h2>
      <p class="section-note">Čtyři oblasti, dvacet závazků, sedm konkrétních projektů. Přečtěte si program tam, kde vznikl.</p>
      <div class="section-cta stat-links" style="justify-content:center">
        <a class="btn btn-primary btn-lg" href={u('program.html')}>Náš program</a>
        <a class="btn btn-secondary btn-lg" href={u('kandidati.html')}>Naši kandidáti</a>
      </div>
    </div>
  </section>
</Base>
