---
// PLNÁ verze programu — veřejná od 7. 9. 2026 (dřív teaser se čtyřmi oblastmi,
// plná verze ležela ve skrytém náhledu, viz src/lib/rezim.js).
// Data: oblasti.js (závazky) + projekty.js (vize). PDF: public/assets/.
import Base from '../layouts/Base.astro';
import { oblasti } from '../data/oblasti.js';
import { projekty } from '../data/projekty.js';
import { u } from '../lib/url.js';

// vize navázané na oblast — pořadí drží oblasti.js
const vizeProOblast = o => o.projekty.map(s => projekty.find(p => p.slug === s)).filter(Boolean);

// Zařazení projektu do oblasti — tag u každého projektu v rozpisu níže.
// Zdroj je pole `projekty` v oblasti.js; projekt bez oblasti se vypíše jako nezařazený.
const oblastProProjekt = (slug) => oblasti.find(o => o.projekty.includes(slug)) ?? null;
const nezarazene = projekty.filter(p => !oblastProProjekt(p.slug));

// „Nová / Nové / Nový" na začátku názvu jde do červeného boxu (.hl) jako v nadpisech.
const rozdelNove = (nazev) => {
  const m = nazev.match(/^(Nov[áéý])\s+(.+)$/);
  return m ? { nove: m[1], zbytek: m[2] } : { nove: null, zbytek: nazev };
};

// Odkazy z projektů na podstránky (např. Javorový) vedou na stránky, které zatím
// nejsou veřejné (src/pages/nahled-k7x2m9/). Dokud nejsou venku, veřejný program
// je nevykresluje. Až bude podstránka veřejná, přepni na true.
const ODKAZY_PROJEKTU = false;

const udalostFB = 'https://www.facebook.com/events/2134356773779029/';
const PDF = 'assets/program-osobnosti-pro-trinec-2026.pdf';
---
<Base
  title="Program 2026 — Osobnosti pro Třinec"
  description={`Program hnutí Osobnosti pro Třinec pro komunální volby 2026: čtyři oblasti, u každé konkrétní závazky, a ${projekty.length} nových investic pro Třinec. Moderní a bezpečné město, sport a kultura, práce a podnikání, sociální péče a zdraví. Ke stažení i v PDF.`}
  path="program.html"
  active="program"
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Program 2026</p>
      <h1>Jasná a konkrétní vize.<br>Pro <span class="hl">Nový Třinec</span>.</h1>
      <p class="hero-lead">
        Žádné obecné fráze. Čtyři oblasti, u každé konkrétní závazky —
        a projekty, které z nich chceme postavit. Program máte i v PDF.
      </p>
      <div class="stat-links">
        <a class="btn btn-primary" href={u(PDF)} target="_blank" rel="noopener">Stáhnout PDF</a>
        <a class="btn btn-secondary" href={u('kandidati.html')}>Kdo to bude prosazovat</a>
      </div>
    </div>
  </section>

  <div class="areas">
    {oblasti.map(o => (
      <section class="area" id={`oblast-${o.cislo}`}>
        <div class="container area-grid">
          <div class="area-photo">
            <img
              src={u(`assets/img/projekty/${o.obrazek}`)}
              alt={`Vizualizace — ${vizeProOblast(o)[0]?.nazev ?? o.nazev}`}
              loading="lazy">
          </div>
          <div class="area-body">
            <h2><span class="hl">{o.klic}</span> Třinec.</h2>
            <p class="area-podnadpis">{o.podnadpis}</p>
            <ul class="area-list">
              {o.body.map(b => <li set:html={b} />)}
            </ul>
          </div>
        </div>
      </section>
    ))}
  </div>

  <!-- Vlastní pasáž k příměstským částem (/casti.html) — v oblastech výše je
       jen jedna odrážka, téma si zaslouží víc prostoru. -->
  <section class="section casti-odkaz">
    <div class="container">
      <p class="eyebrow">Program · části města</p>
      <h2>A co <span class="hl">příměstské</span> části?</h2>
      <p class="section-note">
        Guty, Nebory, Oldřichovice, Kanada, Karpentná, Kojkovice, Osůvky, Tyra,
        Horní Líštná i Konská s Podlesím mají vlastní pasáž — s čísly, kolik do nich
        za poslední čtyři roky šlo, a s pěti závazky, které platí pro všechny stejně.
      </p>
      <div class="stat-links">
        <a class="btn btn-secondary" href={u('casti.html')}>Program pro příměstské části</a>
      </div>
    </div>
  </section>

  <!-- ================= Rozpis projektů — každý s tagem oblasti ================= -->
  <section class="section projekty-rozpis" id="projekty">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Vize · projekty</p>
        <h2>{projekty.length} <span class="hl">nových</span> investic pro Třinec.</h2>
        <p class="section-note">
          Každý projekt patří k některé z {oblasti.length} oblastí — tag u názvu ukazuje ke které.
        </p>
      </div>

      <ol class="proj-list">
        {projekty.map(p => {
          const o = oblastProProjekt(p.slug);
          return (
            <li class="proj-row" id={`projekt-${p.slug}`}>
              <div class="proj-foto">
                <img src={u(`assets/img/projekty/${p.obrazek}`)} alt={p.alt} loading="lazy">
              </div>
              <div class="proj-body">
                <p class="proj-head">
                  <span class="proj-nazev">
                    {rozdelNove(p.nazev).nove && <span class="hl">{rozdelNove(p.nazev).nove}</span>}
                    {rozdelNove(p.nazev).nove ? ' ' : ''}{rozdelNove(p.nazev).zbytek}
                  </span>
                  {p.tag === false ? null : o
                    ? <a class="proj-tag" href={`#oblast-${o.cislo}`}>{o.klic}</a>
                    : <span class="proj-tag proj-tag-chybi">bez oblasti</span>}
                </p>
                <p class="proj-text">{p.text}</p>
                {ODKAZY_PROJEKTU && p.odkaz && <a class="people-more" href={u(p.odkaz.href)}>{p.odkaz.text}</a>}
              </div>
            </li>
          );
        })}
      </ol>

      {nezarazene.length > 0 && (
        <p class="section-note">
          Pozor: {nezarazene.length} projektů nemá v oblasti.js zařazení —
          {nezarazene.map(p => ` ${p.nazev}`).join(',')}.
        </p>
      )}
    </div>
  </section>

  <section class="section section-cta-band">
    <div class="container">
      <h2><span class="hl">Srdcem</span> pro Třinec.</h2>
      <p class="section-note">Volby do zastupitelstva Třince se konají 9.–10. října 2026.</p>
      <div class="section-cta stat-links" style="justify-content:center">
        <a class="btn btn-secondary btn-lg" href={u('kandidati.html')}>Naše kandidátka</a>
        <a class="btn btn-blue btn-lg" href={udalostFB} target="_blank" rel="noopener">Chci volit!</a>
      </div>
    </div>
  </section>
</Base>
