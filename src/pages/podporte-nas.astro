---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url.js';

const podnav = [
  { id: 'udalost',   label: 'Událost na Facebooku' },
  { id: 'srdicko',   label: 'Srdíčko na profilovku' },
  { id: 'site',      label: 'Sociální sítě' },
  { id: 'akce',      label: 'Meetingy a akce' },
  { id: 'prispevek', label: 'Finanční příspěvek' },
  { id: 'fakturace', label: 'Fakturační údaje' },
];
---
<Base
  title="Podpořte nás — Osobnosti pro Třinec"
  description="Podpořte hnutí Osobnosti pro Třinec — sledujte nás, přijďte na akce, přispějte na kampaň. Komunální volby 9.–10. října 2026."
  path="podporte-nas.html"
  active="podporte"
>
  <!-- ================= INTRO ================= -->
  <section class="hero">
    <div class="container">
      <div class="hero-copy" style="max-width: 720px;">
        <p class="eyebrow">Podpořte nás</p>
        <h1>Pomozte nám <span class="hl">měnit</span> Třinec.</h1>
        <p class="hero-lead">
          Kampaň děláme po práci a za vlastní. Každé sdílení, každá účast
          na akci a každý příspěvek nás posune dál. Děkujeme.
        </p>
      </div>
    </div>
  </section>

  <!-- ================= PODMENU ================= -->
  <nav class="podnav" aria-label="Obsah stránky">
    <div class="container">
      <p class="podnav-title">Na této stránce</p>
      <ol class="podnav-list">
        {podnav.map((polozka, i) => (
          <li>
            <a href={`#${polozka.id}`}>
              <span class="podnav-cislo">{String(i + 1).padStart(2, '0')}</span>
              <span class="podnav-label">{polozka.label}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </nav>

  <!-- ================= 01 · FB UDÁLOST ================= -->
  <section class="section podpora-sekce" id="udalost">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">01 · Přidejte se k události</p>
        <h2>Volím Osobnosti</h2>
        <p class="section-note">
          Dejte ostatním vědět, že jdete volit. Přidání do události uvidí
          vaši přátelé — je to nejrychlejší způsob, jak nám pomoct.
        </p>
      </div>
      <a class="akce-karta" href="https://www.facebook.com/events/2134356773779029/" target="_blank" rel="noopener">
        <span class="akce-ikona">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <path d="M16 2v4M8 2v4M3 10h18"/>
            <path d="m9 16 2 2 4-4"/>
          </svg>
        </span>
        <span class="akce-text">
          <span class="akce-nadpis">9.–10. října 2026 · Třinec</span>
          <span class="akce-popis">
            Událost „Volím Osobnosti“ na Facebooku. Jedno kliknutí,
            žádná registrace, žádné údaje navíc.
          </span>
        </span>
        <span class="btn btn-primary btn-lg akce-btn">Přidat se k události</span>
      </a>
    </div>
  </section>

  <!-- ================= 02 · SRDÍČKO NA PROFILOVKU ================= -->
  <section class="section podpora-sekce" id="srdicko">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">02 · Ukažte to na profilu</p>
        <h2>Srdíčko na profilovku</h2>
        <p class="section-note">
          Nahrajete fotku, srovnáte výřez a stáhnete si profilovku se srdíčkem
          Osobností. Na telefonu ji pošlete rovnou do Facebooku. Trvá to minutu.
        </p>
      </div>
      <a class="akce-karta" href={u('srdicko.html')}>
        <span class="akce-ikona">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.8 6.6a5 5 0 0 0-7.1 0L12 8.3l-1.7-1.7a5 5 0 1 0-7.1 7.1l1.7 1.7L12 22.5l7.1-7.1 1.7-1.7a5 5 0 0 0 0-7.1z"/>
          </svg>
        </span>
        <span class="akce-text">
          <span class="akce-nadpis">Vaše fotka zůstává u vás</span>
          <span class="akce-popis">
            Obrázek skládá váš prohlížeč — nikam se neodesílá ani neukládá.
            Výsledek je PNG 1080 × 1080 px pro Facebook i Instagram.
          </span>
        </span>
        <span class="btn btn-primary btn-lg akce-btn">Vyrobit profilovku</span>
      </a>
    </div>
  </section>

  <!-- ================= 03 · SOCIÁLNÍ SÍTĚ ================= -->
  <section class="section podpora-sekce" id="site">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">03 · Sledujte nás</p>
        <h2>Sociální sítě</h2>
        <p class="section-note">
          Novinky, akce a lidé z kampaně. Sledovat a sdílet je pomoc,
          která nic nestojí.
        </p>
      </div>
      <div class="support-grid">
        <a class="support-card" href="https://www.facebook.com/osobnostiprotrinec" target="_blank" rel="noopener">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          <h3>Facebook</h3>
          <p>Novinky z kampaně, akce, lidé. Sledujte a sdílejte.</p>
          <span class="support-link">facebook.com/osobnostiprotrinec →</span>
        </a>
        <a class="support-card" href="https://www.instagram.com/osobnosti_pro_trinec/" target="_blank" rel="noopener">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><line x1="17.5" y1="6.5" x2="17.5" y2="6.5"/></svg>
          <h3>Instagram</h3>
          <p>Fotky a videa z kampaně, lidé, zákulisí. Dejte nám follow.</p>
          <span class="support-link">@osobnosti_pro_trinec →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ================= 04 · MEETINGY A AKCE ================= -->
  <section class="section podpora-sekce" id="akce">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">04 · Potkejme se</p>
        <h2>Meetingy a akce</h2>
        <p class="section-note">
          Přijďte si popovídat — o programu, o městě, o čemkoli.
          Termíny průběžně doplňujeme a zveřejňujeme na{' '}
          <a href="https://www.facebook.com/osobnostiprotrinec/events" target="_blank" rel="noopener">Facebooku</a>.
        </p>
      </div>
      {/* Placeholder termíny skryté do doby, než budou známé reálné akce —
          stačí smazat `false &&` a doplnit datum, místo a popis. */}
      {false && (
        <div class="event-list">
          <article class="event">
            <div class="event-date">
              <span class="event-day">—</span>
              <span class="event-month">brzy</span>
            </div>
            <div class="event-body">
              <h3>Setkání s kandidáty</h3>
              <p>Termín a místo doplníme. Sledujte Facebook.</p>
            </div>
          </article>
        </div>
      )}
      <div class="section-cta">
        <a class="btn btn-secondary btn-lg" href="https://www.facebook.com/osobnostiprotrinec/events" target="_blank" rel="noopener">Všechny akce na Facebooku</a>
      </div>
    </div>
  </section>

  <!-- ================= 05 · FINANČNÍ PŘÍSPĚVEK ================= -->
  <section class="section podpora-sekce" id="prispevek">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">05 · Přispějte na kampaň</p>
        <h2>Finanční příspěvek</h2>
        <p class="section-note">
          Tisk, plakáty, web, nájmy sálů. Vše platíme z transparentního účtu,
          takže je vidět každá koruna na obou stranách.
        </p>
      </div>
      <div class="donate-grid">
        <div class="donate-box">
          <h3>Transparentní účet</h3>
          <div class="account-number">112825162/0100</div>
          <p>
            Každá koruna jde vidět — účet je ze zákona transparentní
            a veškeré pohyby jsou veřejné. Prohlédněte si je přímo
            na <a href="https://www.kb.cz/cs/transparentni-ucty/112825162" target="_blank" rel="noopener">stránkách Komerční banky</a>.
          </p>
          <a class="btn btn-primary" href="https://www.kb.cz/cs/transparentni-ucty/112825162" target="_blank" rel="noopener">Pohyby na účtu</a>
        </div>
        <div class="donate-note">
          <h3>Jak to funguje</h3>
          <ul>
            <li>Příspěvek pošlete převodem na transparentní účet.</li>
            <li>U darů vás poprosíme o pár údajů — zákon o politických
              hnutích nám ukládá dárce evidovat.</li>
            <li>S větším darem nám napište zprávu na{' '}
              <a href="https://www.facebook.com/osobnostiprotrinec" target="_blank" rel="noopener">Facebooku</a>,
              připravíme darovací smlouvu.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 06 · FAKTURAČNÍ ÚDAJE ================= -->
  <section class="section podpora-sekce" id="fakturace">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">06 · Pro dárce a dodavatele</p>
        <h2>Fakturační údaje</h2>
        <p class="section-note">
          Zadavatelem i zpracovatelem kampaně je politické hnutí NOVÁ GENERACE.
          Tyto údaje použijte pro darovací smlouvu i pro fakturaci.
        </p>
      </div>
      <div class="fakturacni">
        <dl class="fakturacni-list">
          <div class="fakturacni-radek">
            <dt>Název</dt>
            <dd>NOVÁ GENERACE</dd>
          </div>
          <div class="fakturacni-radek">
            <dt>Právní forma</dt>
            <dd>Politické hnutí</dd>
          </div>
          <div class="fakturacni-radek">
            <dt>Sídlo</dt>
            <dd>Poštovní 244, Staré Město, 739 61 Třinec</dd>
          </div>
          <div class="fakturacni-radek">
            <dt>IČO</dt>
            <dd>29 68 47 73</dd>
          </div>
          <div class="fakturacni-radek">
            <dt>DIČ</dt>
            <dd>Neplátce DPH</dd>
          </div>
          <div class="fakturacni-radek">
            <dt>Datová schránka</dt>
            <dd>t5ty7t4</dd>
          </div>
          <div class="fakturacni-radek">
            <dt>Bankovní spojení</dt>
            <dd>112825162/0100 — Komerční banka (transparentní účet)</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <style>
    /* ---------- Podmenu (obsah stránky) ---------- */
    .podnav {
      margin-top: var(--s-64);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      padding: var(--s-24) 0;
    }
    .podnav-title {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 12px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: var(--s-16);
    }
    .podnav-list {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s-8) var(--s-24);
    }
    .podnav-list a {
      display: flex;
      align-items: baseline;
      gap: 10px;
      padding: 6px 0;
      text-decoration: none;
      color: var(--text);
      transition: color 240ms var(--ease-ui);
    }
    .podnav-cislo {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 12px;
      letter-spacing: 0.04em;
      color: var(--text-muted);
      transition: color 240ms var(--ease-ui);
    }
    .podnav-label {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 14px;
      letter-spacing: 0.02em;
    }
    .podnav-list a:hover { color: var(--signal-blue); }
    .podnav-list a:hover .podnav-cislo { color: var(--signal-blue); }

    /* ---------- Sjednocené sekce ---------- */
    .podpora-sekce { scroll-margin-top: 88px; }
    .podpora-sekce + .podpora-sekce { border-top: 1px solid var(--border); }
    .podpora-sekce .section-head { margin-bottom: var(--s-40); }

    /* ---------- Akční karta (událost, srdíčko) ---------- */
    .akce-karta {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: var(--s-40);
      align-items: center;
      max-width: 900px;
      padding: var(--s-40);
      border: 1px solid var(--border);
      text-decoration: none;
      color: var(--text);
      transition: border-color 240ms var(--ease-ui), box-shadow 240ms var(--ease-ui);
    }
    .akce-karta:hover {
      border-color: var(--anthracite);
      box-shadow: 0 8px 24px rgba(50, 50, 50, 0.10);
    }
    .akce-ikona {
      width: 88px;
      height: 88px;
      flex: 0 0 auto;
      border-radius: 50%;
      border: 1px solid var(--border);
      color: var(--signal-blue);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .akce-ikona svg { width: 40px; height: 40px; }
    .akce-text { display: block; min-width: 0; }
    .akce-nadpis {
      display: block;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 20px;
      margin-bottom: var(--s-8);
    }
    .akce-popis {
      display: block;
      color: var(--text-secondary);
      font-size: 14px;
      max-width: 48ch;
      overflow-wrap: break-word;
    }
    .akce-btn { white-space: nowrap; }

    @media (max-width: 900px) {
      .podnav-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .akce-karta {
        grid-template-columns: minmax(0, 1fr);
        justify-items: center;
        text-align: center;
        gap: var(--s-24);
        padding: var(--s-24);
      }
      .akce-ikona { width: 72px; height: 72px; }
      .akce-text { width: 100%; }
      .akce-ikona svg { width: 32px; height: 32px; }
      .akce-popis { margin-left: auto; margin-right: auto; }
      .akce-btn { width: 100%; text-align: center; justify-content: center; white-space: normal; }
    }
    @media (max-width: 560px) {
      .podnav-list { grid-template-columns: 1fr; }
    }
  </style>
</Base>
