---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url.js';
import { sdeleni, poznamky } from '../data/transparentnost.js';

const podnav = [
  { id: 'udalost',   label: 'Událost na Facebooku' },
  { id: 'srdicko',   label: 'Srdíčko na profilovku' },
  { id: 'site',      label: 'Sociální sítě' },
  { id: 'akce',      label: 'Meetingy a akce' },
  { id: 'prispevek', label: 'Finanční příspěvek' },
  { id: 'fakturace', label: 'Fakturační údaje' },
  { id: 'transparentnost', label: 'Transparentnost reklamy' },
];
---
<Base
  title="Podpořte nás — Osobnosti pro Třinec"
  description="Podpořte hnutí Osobnosti pro Třinec — sledujte nás, přijďte na akce, přispějte na kampaň. Komunální volby 9.–10. října 2026."
  path="podporte-nas.html"
  active="podporte"
>
  <!-- ================= INTRO ================= -->
  <section class="hero">
    <div class="container">
      <div class="hero-copy" style="max-width: 720px;">
        <p class="eyebrow">Podpořte nás</p>
        <h1>Pomozte nám <span class="hl">měnit</span> Třinec.</h1>
        <p class="hero-lead">
          Kampaň děláme po práci a za vlastní. Každé sdílení, každá účast
          na akci a každý příspěvek nás posune dál. Děkujeme.
        </p>
      </div>
    </div>
  </section>

  <!-- ================= PODMENU ================= -->
  <nav class="podnav" aria-label="Obsah stránky">
    <div class="container">
      <p class="podnav-title">Na této stránce</p>
      <ol class="podnav-list">
        {podnav.map((polozka, i) => (
          <li>
            <a href={`#${polozka.id}`}>
              <span class="podnav-cislo">{String(i + 1).padStart(2, '0')}</span>
              <span class="podnav-label">{polozka.label}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </nav>

  <!-- ================= 01 · FB UDÁLOST ================= -->
  <section class="section podpora-sekce" id="udalost">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">01 · Přidejte se k události</p>
        <h2>Volím Osobnosti</h2>
        <p class="section-note">
          Dejte ostatním vědět, že jdete volit. Přidání do události uvidí
          vaši přátelé — je to nejrychlejší způsob, jak nám pomoct.
        </p>
      </div>
      <a class="akce-karta" href="https://www.facebook.com/events/2134356773779029/" target="_blank" rel="noopener">
        <span class="akce-ikona">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <path d="M16 2v4M8 2v4M3 10h18"/>
            <path d="m9 16 2 2 4-4"/>
          </svg>
        </span>
        <span class="akce-text">
          <span class="akce-nadpis">9.–10. října 2026 · Třinec</span>
          <span class="akce-popis">
            Událost „Volím Osobnosti“ na Facebooku. Jedno kliknutí,
            žádná registrace, žádné údaje navíc.
          </span>
        </span>
        <span class="btn btn-primary btn-lg akce-btn">Přidat se k události</span>
      </a>
    </div>
  </section>

  <!-- ================= 02 · SRDÍČKO NA PROFILOVKU ================= -->
  <section class="section podpora-sekce" id="srdicko">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">02 · Ukažte to na profilu</p>
        <h2>Srdíčko na profilovku</h2>
        <p class="section-note">
          Nahrajete fotku, srovnáte výřez a stáhnete si profilovku se srdíčkem
          Osobností. Na telefonu ji pošlete rovnou do Facebooku. Trvá to minutu.
        </p>
      </div>
      <a class="akce-karta" href={u('srdicko.html')}>
        <span class="akce-ikona">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.8 6.6a5 5 0 0 0-7.1 0L12 8.3l-1.7-1.7a5 5 0 1 0-7.1 7.1l1.7 1.7L12 22.5l7.1-7.1 1.7-1.7a5 5 0 0 0 0-7.1z"/>
          </svg>
        </span>
        <span class="akce-text">
          <span class="akce-nadpis">Vaše fotka zůstává u vás</span>
          <span class="akce-popis">
            Obrázek skládá váš prohlížeč — nikam se neodesílá ani neukládá.
            Výsledek je PNG 1080 × 1080 px pro Facebook i Instagram.
          </span>
        </span>
        <span class="btn btn-primary btn-lg akce-btn">Vyrobit profilovku</span>
      </a>
    </div>
  </section>

  <!-- ================= 03 · SOCIÁLNÍ SÍTĚ ================= -->
  <section class="section podpora-sekce" id="site">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">03 · Sledujte nás</p>
        <h2>Sociální sítě</h2>
        <p class="section-note">
          Novinky, akce a lidé z kampaně. Sledovat a sdílet je pomoc,
          která nic nestojí.
        </p>
      </div>
      <div class="support-grid">
        <a class="support-card" href="https://www.facebook.com/osobnostiprotrinec" target="_blank" rel="noopener">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          <h3>Facebook</h3>
          <p>Novinky z kampaně, akce, lidé. Sledujte a sdílejte.</p>
          <span class="support-link">facebook.com/<wbr>osobnostiprotrinec →</span>
        </a>
        <a class="support-card" href="https://www.instagram.com/osobnosti_pro_trinec/" target="_blank" rel="noopener">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><line x1="17.5" y1="6.5" x2="17.5" y2="6.5"/></svg>
          <h3>Instagram</h3>
          <p>Fotky a videa z kampaně, lidé, zákulisí. Dejte nám follow.</p>
          <span class="support-link">@osobnosti_pro_trinec →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ================= 04 · MEETINGY A AKCE ================= -->
  <section class="section podpora-sekce" id="akce">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">04 · Potkejme se</p>
        <h2>Meetingy a akce</h2>
        <p class="section-note">
          Přijďte si popovídat — o programu, o městě, o čemkoli.
          Termíny průběžně doplňujeme a zveřejňujeme na{' '}
          <a href="https://www.facebook.com/osobnostiprotrinec/events" target="_blank" rel="noopener">Facebooku</a>.
        </p>
      </div>
      {/* Placeholder termíny skryté do doby, než budou známé reálné akce —
          stačí smazat `false &&` a doplnit datum, místo a popis. */}
      {false && (
        <div class="event-list">
          <article class="event">
            <div class="event-date">
              <span class="event-day">—</span>
              <span class="event-month">brzy</span>
            </div>
            <div class="event-body">
              <h3>Setkání s kandidáty</h3>
              <p>Termín a místo doplníme. Sledujte Facebook.</p>
            </div>
          </article>
        </div>
      )}
      <div class="section-cta">
        <a class="btn btn-secondary btn-lg" href="https://www.facebook.com/osobnostiprotrinec/events" target="_blank" rel="noopener">Všechny akce na Facebooku</a>
      </div>
    </div>
  </section>

  <!-- ================= 05 · FINANČNÍ PŘÍSPĚVEK ================= -->
  <section class="section podpora-sekce" id="prispevek">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">05 · Přispějte na kampaň</p>
        <h2>Finanční příspěvek</h2>
        <p class="section-note">
          Tisk, plakáty, web, nájmy sálů. Vše platíme z transparentního účtu,
          takže je vidět každá koruna na obou stranách.
        </p>
      </div>
      <div class="donate-grid">
        <div class="donate-box">
          <h3>Transparentní účet</h3>
          <div class="account-number">112825162/0100</div>
          <p>
            Každá koruna jde vidět — účet je ze zákona transparentní
            a veškeré pohyby jsou veřejné. Prohlédněte si je přímo
            na <a href="https://www.kb.cz/cs/transparentni-ucty/112825162" target="_blank" rel="noopener">stránkách Komerční banky</a>.
          </p>
          <a class="btn btn-primary" href="https://www.kb.cz/cs/transparentni-ucty/112825162" target="_blank" rel="noopener">Pohyby na účtu</a>
        </div>
        <div class="donate-note">
          <h3>Jak to funguje</h3>
          <ul>
            <li>Příspěvek pošlete převodem na transparentní účet.</li>
            <li>U darů vás poprosíme o pár údajů — zákon o politických
              hnutích nám ukládá dárce evidovat.</li>
            <li>S větším darem nám napište zprávu na{' '}
              <a href="https://www.facebook.com/osobnostiprotrinec" target="_blank" rel="noopener">Facebooku</a>,
              připravíme darovací smlouvu.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 06 · FAKTURAČNÍ ÚDAJE ================= -->
  <section class="section podpora-sekce" id="fakturace">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">06 · Pro dárce a dodavatele</p>
        <h2>Fakturační údaje</h2>
        <p class="section-note">
          Zadavatelem i zpracovatelem kampaně je politické hnutí NOVÁ GENERACE.
          Tyto údaje použijte pro darovací smlouvu i pro fakturaci.
        </p>
      </div>
      <div class="fakturacni">
        <dl class="fakturacni-list">
          <div class="fakturacni-radek">
            <dt>Název</dt>
            <dd>NOVÁ GENERACE</dd>
          </div>
          <div class="fakturacni-radek">
            <dt>Právní forma</dt>
            <dd>Politické hnutí</dd>
          </div>
          <div class="fakturacni-radek">
            <dt>Sídlo</dt>
            <dd>Poštovní 244, Staré Město, 739 61 Třinec</dd>
          </div>
          <div class="fakturacni-radek">
            <dt>IČO</dt>
            <dd>29 68 47 73</dd>
          </div>
          <div class="fakturacni-radek">
            <dt>DIČ</dt>
            <dd>Neplátce DPH</dd>
          </div>
          <div class="fakturacni-radek">
            <dt>Datová schránka</dt>
            <dd>t5ty7t4</dd>
          </div>
          <div class="fakturacni-radek">
            <dt>Bankovní spojení</dt>
            <dd>112825162/0100 — Komerční banka (transparentní účet)</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- ================= 07 · TRANSPARENTNOST POLITICKÉ REKLAMY ================= -->
  <section class="section podpora-sekce" id="transparentnost">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">07 · Kdo platí naši kampaň</p>
        <h2>Oznámení o transparentnosti politické reklamy</h2>
        <p class="section-note">
          Níže naleznete přehled politických reklamních sdělení ve smyslu
          nařízení (EU) 2024/900 a doprovodných informací.
        </p>
      </div>

      <div class="transp">
        <div class="transp-blok">
          <h3>1. Identifikace zadavatele</h3>
          <dl class="fakturacni-list">
            <div class="fakturacni-radek"><dt>Zadavatel</dt><dd>Politické hnutí NOVÁ GENERACE</dd></div>
            <div class="fakturacni-radek"><dt>IČO</dt><dd>29 68 47 73</dd></div>
            <div class="fakturacni-radek"><dt>Sídlo</dt><dd>Poštovní 244, 739 61 Třinec</dd></div>
            <div class="fakturacni-radek"><dt>E-mail</dt><dd><a href="mailto:lucie.fremrova@gmail.com">lucie.fremrova@gmail.com</a></dd></div>
          </dl>
        </div>

        <div class="transp-blok">
          <h3>2. Financování</h3>
          <p>Níže zveřejněná reklamní sdělení jsou financována pouze zadavatelem.</p>
          <p>
            Částky, které poskytovatelé / vydavatelé obdrželi od zadavatele
            v souvislosti se službou politické reklamy, pocházejí z příjmů
            politického hnutí dle § 17 odst. 8 zákona o sdružování v politických
            stranách a hnutích. Jedná se o soukromé prostředky pocházející
            z EU.<sup>(1)</sup>
          </p>
        </div>

        <div class="transp-blok">
          <h3>3. Přehled politických reklamních sdělení</h3>
          <p>
            Oficiální informace o způsobech účasti ve volbách najdete na{' '}
            <a href="https://mv.gov.cz/volby-referenda/druhy-voleb" target="_blank" rel="noopener">stránkách Ministerstva vnitra</a>.
          </p>
          <p>
            Upozornění na politická reklamní sdělení, která mohou být v rozporu
            s pravidly, lze učinit e-mailem
            (<a href="mailto:lucie.fremrova@gmail.com">lucie.fremrova@gmail.com</a>)
            nebo datovou schránkou (ID: t5ty7t4).
          </p>
          <p>
            Zadavatel je oprávněn politickou reklamu zadat a poskytnuté údaje
            jsou pravdivé, úplné a aktuální. Obsah sdělení neporušuje právní
            předpisy ani práva třetích osob. Zadavatel prohlašuje, že jde
            o politickou reklamu.
          </p>
        </div>
      </div>

      <div class="transp-tabulka" role="region" aria-label="Přehled politických reklamních sdělení" tabindex="0">
        <table>
          <thead>
            <tr>
              <th scope="col">Typ reklamního sdělení</th>
              <th scope="col">Vydavatel</th>
              <th scope="col">Období<sup>(2)</sup></th>
              <th scope="col">Souvislost s</th>
              <th scope="col">Částka za sdělení (Kč vč. DPH)<sup>(3)</sup></th>
              <th scope="col">Částka za kampaň (Kč vč. DPH)<sup>(4)</sup></th>
              <th scope="col">Metodika výpočtu<sup>(5)</sup></th>
              <th scope="col">Cílení<sup>(6)</sup></th>
              <th scope="col">Poznámka</th>
            </tr>
          </thead>
          <tbody>
            {sdeleni.map((r) => (
              <tr>
                <th scope="row">{r.typ}</th>
                <td>{r.vydavatel}</td>
                <td class="nowrap">{r.obdobi}</td>
                <td>{r.souvislost}</td>
                <td class="cislo">{r.castkaSdeleni || <span class="doplnime">doplníme</span>}</td>
                <td class="cislo">{r.castkaKampan || <span class="doplnime">doplníme</span>}</td>
                <td>{r.metodika}</td>
                <td>{r.cileni}</td>
                <td>{r.poznamka || '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <ol class="transp-poznamky">
        {poznamky.map((text) => <li>{text}</li>)}
      </ol>
    </div>
  </section>

  <style>
    /* ---------- Podmenu (obsah stránky) ---------- */
    .podnav {
      margin-top: var(--s-64);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      padding: var(--s-24) 0;
    }
    .podnav-title {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 12px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: var(--s-16);
    }
    .podnav-list {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s-8) var(--s-24);
    }
    .podnav-list a {
      display: flex;
      align-items: baseline;
      gap: 10px;
      padding: 6px 0;
      text-decoration: none;
      color: var(--text);
      transition: color 240ms var(--ease-ui);
    }
    .podnav-cislo {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 12px;
      letter-spacing: 0.04em;
      color: var(--text-muted);
      transition: color 240ms var(--ease-ui);
    }
    .podnav-label {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 14px;
      letter-spacing: 0.02em;
    }
    .podnav-list a:hover { color: var(--signal-blue); }
    .podnav-list a:hover .podnav-cislo { color: var(--signal-blue); }

    /* ---------- Sjednocené sekce ---------- */
    .podpora-sekce { scroll-margin-top: 88px; }
    .podpora-sekce + .podpora-sekce { border-top: 1px solid var(--border); }
    .podpora-sekce .section-head { margin-bottom: var(--s-40); }

    /* ---------- Akční karta (událost, srdíčko) ---------- */
    .akce-karta {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: var(--s-40);
      align-items: center;
      max-width: 900px;
      padding: var(--s-40);
      border: 1px solid var(--border);
      text-decoration: none;
      color: var(--text);
      transition: border-color 240ms var(--ease-ui), box-shadow 240ms var(--ease-ui);
    }
    .akce-karta:hover {
      border-color: var(--anthracite);
      box-shadow: 0 8px 24px rgba(50, 50, 50, 0.10);
    }
    .akce-ikona {
      width: 88px;
      height: 88px;
      flex: 0 0 auto;
      border-radius: 50%;
      border: 1px solid var(--border);
      color: var(--signal-blue);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .akce-ikona svg { width: 40px; height: 40px; }
    .akce-text { display: block; min-width: 0; }
    .akce-nadpis {
      display: block;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 20px;
      margin-bottom: var(--s-8);
    }
    .akce-popis {
      display: block;
      color: var(--text-secondary);
      font-size: 14px;
      max-width: 48ch;
      overflow-wrap: break-word;
    }
    .akce-btn { white-space: nowrap; }

    /* ---------- Transparentnost politické reklamy ---------- */
    .transp {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s-40);
      margin-bottom: var(--s-40);
    }
    .transp-blok h3 {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 18px;
      margin-bottom: var(--s-16);
    }
    .transp-blok p {
      color: var(--text-secondary);
      font-size: 14px;
      margin-bottom: var(--s-16);
      overflow-wrap: break-word;
    }
    /* Ve třetinovém sloupci popisek nad hodnotou — 200px sloupec dt by hodnoty rozsekal. */
    .transp-blok .fakturacni-radek { grid-template-columns: 1fr; gap: 4px; padding: 12px 0; }
    .transp-blok .fakturacni-radek:first-child { padding-top: 0; }
    .transp-blok .fakturacni-radek dd { font-size: 14px; overflow-wrap: anywhere; }
    .transp sup, .transp-tabulka sup { font-size: 0.7em; margin-left: 2px; }
    .transp-tabulka {
      overflow-x: auto;
      border: 1px solid var(--border);
    }
    .transp-tabulka table {
      width: 100%;
      min-width: 960px;
      border-collapse: collapse;
      font-size: 14px;
    }
    .transp-tabulka th,
    .transp-tabulka td {
      text-align: left;
      vertical-align: top;
      padding: 12px 14px;
      border-bottom: 1px solid var(--border);
      overflow-wrap: normal;
      word-break: normal;
      hyphens: manual;
    }
    .transp-tabulka thead th {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 12px;
      letter-spacing: 0.04em;
      color: var(--text-muted);
      background: var(--white, #fff);
    }
    .transp-tabulka tbody th { font-family: var(--font-display); font-weight: 700; }
    .transp-tabulka tbody tr:last-child > * { border-bottom: 0; }
    .transp-tabulka .nowrap { white-space: nowrap; }
    .transp-tabulka .cislo { white-space: nowrap; }
    .transp-tabulka .doplnime { color: var(--text-muted); font-style: italic; }
    .transp-poznamky {
      margin-top: var(--s-24);
      padding-left: 1.6em;
      color: var(--text-muted);
      font-size: 12px;
      max-width: 90ch;
    }
    .transp-poznamky li { margin-bottom: 4px; }
    .transp-poznamky li::marker { content: "(" counter(list-item) ")  "; }
    @media (max-width: 900px) {
      .transp { grid-template-columns: minmax(0, 1fr); gap: var(--s-24); }
    }

    @media (max-width: 900px) {
      .podnav-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
